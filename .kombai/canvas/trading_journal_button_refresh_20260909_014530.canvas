      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#06111f] px-8 py-8 font-[Inter,sans-serif] text-slate-100\" data-kid=\"1\" data-name=\"trading journal application\">\n    <div class=\"mx-auto max-w-[1180px] space-y-6\" data-kid=\"1-1\" data-name=\"page content container\">\n        <header class=\"rounded-[26px] border border-slate-800/90 bg-[#0b1729]/95 p-5 shadow-[0_20px_70px_rgba(0,0,0,0.28)]\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div class=\"flex items-start justify-between gap-6\" data-kid=\"1-1-1-1\" data-name=\"header top row\">\n                <div class=\"min-w-[260px]\" data-kid=\"1-1-1-1-1\" data-name=\"header title group\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.28em] text-cyan-300\" data-kid=\"1-1-1-1-1-1\" data-name=\"page subtitle\">\n                        Trading journal\n                    </p>\n                    <h1 class=\"mt-2 text-[30px] font-semibold leading-tight tracking-[-0.03em] text-white\" data-kid=\"1-1-1-1-1-2\" data-name=\"page headline\">\n                        Stock Performance\n                        <br data-kid=\"1-1-1-1-1-2-1\" data-name=\"headline line break\"/>\n                        Dashboard\n                    </h1>\n                </div>\n                <div class=\"flex flex-1 items-start justify-end gap-4\" data-kid=\"1-1-1-1-2\" data-name=\"header controls group\">\n                    <nav aria-label=\"Primary navigation\" class=\"flex max-w-[430px] flex-wrap items-center gap-1 rounded-2xl border border-slate-800 bg-[#07101f] p-1.5\" data-kid=\"1-1-1-1-2-1\" data-name=\"primary navigation menu\">\n                        <button aria-current=\"page\" class=\"rounded-xl bg-cyan-400 px-4 py-2.5 text-sm font-semibold text-[#06111f] shadow-[0_8px_22px_rgba(34,211,238,0.18)]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"dashboard navigation button\" type=\"button\">\n                            Dashboard\n                        </button>\n                        <button class=\"rounded-xl px-4 py-2.5 text-sm font-medium text-slate-400 hover:bg-slate-800/70 hover:text-slate-100\" data-kid=\"1-1-1-1-2-1-2\" data-name=\"analytics navigation button\" type=\"button\">\n                            Analytics\n                        </button>\n                        <button class=\"rounded-xl px-4 py-2.5 text-sm font-medium text-slate-400 hover:bg-slate-800/70 hover:text-slate-100\" data-kid=\"1-1-1-1-2-1-3\" data-name=\"position-size navigation button\" type=\"button\">\n                            Position Size\n                        </button>\n                        <button class=\"rounded-xl px-4 py-2.5 text-sm font-medium text-slate-400 hover:bg-slate-800/70 hover:text-slate-100\" data-kid=\"1-1-1-1-2-1-4\" data-name=\"tradovate navigation button\" type=\"button\">\n                            Tradovate\n                        </button>\n                    </nav>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-2-2\" data-name=\"utility controls group\">\n                        <button class=\"rounded-xl border border-slate-700 bg-transparent px-3.5 py-2.5 text-sm font-medium text-slate-300 hover:border-slate-500 hover:bg-slate-800/70 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300/80 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0b1729]\" data-kid=\"1-1-1-1-2-2-1\" data-name=\"light mode toggle button\" type=\"button\">\n                            Light mode\n                        </button>\n                        <div class=\"flex items-center gap-1 rounded-2xl border border-slate-800 bg-[#07101f] p-1\" data-kid=\"1-1-1-1-2-2-2\" data-name=\"csv data action group\">\n                            <button class=\"rounded-xl px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300/80\" data-kid=\"1-1-1-1-2-2-2-1\" data-name=\"export csv button\" type=\"button\">\n                                Export CSV\n                            </button>\n                            <button class=\"rounded-xl px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-300/80\" data-kid=\"1-1-1-1-2-2-2-2\" data-name=\"import csv button\" type=\"button\">\n                                Import CSV\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-5 flex items-center justify-between border-t border-slate-800/80 pt-4\" data-kid=\"1-1-1-2\" data-name=\"header status row\">\n                <p class=\"text-xs text-slate-500\" data-kid=\"1-1-1-2-1\" data-name=\"status message\">\n                    A quieter control system: signal first, surface second.\n                </p>\n                <div class=\"flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-1-2-2\" data-name=\"connection status indicator group\">\n                    <span class=\"h-2 w-2 rounded-full bg-emerald-400\" data-kid=\"1-1-1-2-2-1\" data-name=\"sync status dot\">\n                    </span>\n                    Local journal synced\n                </div>\n            </div>\n        </header>\n        <section aria-label=\"Performance summary\" class=\"grid grid-cols-4 gap-3\" data-kid=\"1-1-2\" data-name=\"performance metrics grid\">\n            <div class=\"rounded-2xl border border-emerald-400/25 bg-[#0b1d2b] p-4\" data-kid=\"1-1-2-1\" data-name=\"total p&l metric card\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-500\" data-kid=\"1-1-2-1-1\" data-name=\"total p&l label\">\n     