  <button class=\"rounded-xl bg-cyan-400 px-4 py-2 text-xs font-semibold text-[#06111f]\" data-kid=\"1-1-4-2-3-1-2\" data-name=\"primary button\" type=\"button\">\n                            Save Trade\n                        </button>\n                    </div>\n                    <div class=\"flex items-center justify-between rounded-2xl border border-cyan-300/35 bg-cyan-300/[0.05] px-4 py-3\" data-kid=\"1-1-4-2-3-2\" data-name=\"focused state row\">\n                        <div data-kid=\"1-1-4-2-3-2-1\" data-name=\"focused label group\">\n                            <p class=\"text-xs font-semibold text-white\" data-kid=\"1-1-4-2-3-2-1-1\" data-name=\"focused state name\">\n                                Focused\n                            </p>\n                            <p class=\"mt-0.5 text-[11px] text-slate-500\" data-kid=\"1-1-4-2-3-2-1-2\" data-name=\"focused state description\">\n                                Keyboard-visible ring\n                            </p>\n                        </div>\n                        <button class=\"rounded-xl bg-cyan-400 px-4 py-2 text-xs font-semibold text-[#06111f] outline-none ring-2 ring-cyan-200 ring-offset-2 ring-offset-[#071322]\" data-kid=\"1-1-4-2-3-2-2\" data-name=\"focused button\" type=\"button\">\n                            Save Trade\n                        </button>\n                    </div>\n                    <div class=\"flex items-center justify-between rounded-2xl border border-slate-800 bg-[#071322] px-4 py-3\" data-kid=\"1-1-4-2-3-3\" data-name=\"pressed state row\">\n                        <div data-kid=\"1-1-4-2-3-3-1\" data-name=\"pressed label group\">\n                            <p class=\"text-xs font-semibold text-white\" data-kid=\"1-1-4-2-3-3-1-1\" data-name=\"pressed state name\">\n                                Pressed\n                            </p>\n                            <p class=\"mt-0.5 text-[11px] text-slate-500\" data-kid=\"1-1-4-2-3-3-1-2\" data-name=\"pressed state description\">\n                                Clear tactile response\n                            </p>\n                        </div>\n                        <button class=\"translate-y-px rounded-xl bg-cyan-500 px-4 py-2 text-xs font-semibold text-[#06111f] shadow-inner shadow-black/20\" data-kid=\"1-1-4-2-3-3-2\" data-name=\"pressed button\" type=\"button\">\n                            Save Trade\n                        </button>\n                    </div>\n                    <div class=\"flex items-center justify-between rounded-2xl border border-slate-800 bg-[#071322] px-4 py-3\" data-kid=\"1-1-4-2-3-4\" data-name=\"disabled state row\">\n                        <div data-kid=\"1-1-4-2-3-4-1\" data-name=\"disabled label group\">\n                            <p class=\"text-xs font-semibold text-white\" data-kid=\"1-1-4-2-3-4-1-1\" data-name=\"disabled state name\">\n                                Disabled\n                            </p>\n                            <p class=\"mt-0.5 text-[11px] text-slate-500\" data-kid=\"1-1-4-2-3-4-1-2\" data-name=\"disabled state description\">\n                                Blocked until connected\n                            </p>\n                        </div>\n                        <button class=\"cursor-not-allowed rounded-xl bg-slate-800 px-4 py-2 text-xs font-semibold text-slate-500\" data-kid=\"1-1-4-2-3-4-2\" data-name=\"disabled button\" disabled=\"\" type=\"button\">\n                            Send Simulated Order\n                        </button>\n                    </div>\n                    <div class=\"flex items-center justify-between rounded-2xl border border-rose-300/20 bg-rose-300/[0.04] px-4 py-3\" data-kid=\"1-1-4-2-3-5\" data-name=\"destructive state row\">\n                        <div data-kid=\"1-1-4-2-3-5-1\" data-name=\"destructive label group\">\n                            <p class=\"text-xs font-semibold text-white\" data-kid=\"1-1-4-2-3-5-1-1\" data-name=\"destructive state name\">\n                                Destructive\n                            </p>\n                            <p class=\"mt-0.5 text-[11px] text-slate-500\" data-kid=\"1-1-4-2-3-5-1-2\" data-name=\"destructive state description\">\n                                Quiet until intent is clear\n                            </p>\n                        </div>\n                        <button class=\"rounded-xl px-3 py-2 text-xs font-semibold text-rose-300 hover:bg-rose-400/10 hover:text-rose-200\" data-kid=\"1-1-4-2-3-5-2\" data-name=\"delete button\" type=\"button\">\n                            Delete\n                        </button>\n                    </div>\n                </div>\n                <div class=\"mt-5 rounded-2xl border border-slate-800 bg-[#071322] p-4\" data-kid=\"1-1-4-2-4\" data-name=\"token notes container\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-500\" data-kid=\"1-1-4-2-4-1\" data-name=\"token notes label\">\n                        Token notes\n                    </p>\n                    <div class=\"mt-3 grid grid-cols-2 gap-2 text-[11px]\" data-kid=\"1-1-4-2-4-2\" data-name=\"token notes grid\">\n                        <span class=\"rounded-lg bg-slate-800/60 px-2.5 py-2 text-slate-300\" data-kid=\"1-1-4-2-4-2-1\" data-name=\"token note item 1\">\n                            12px control radius\n                        </span>\n                        <span class=\"rounded-lg bg-slate-800/60 px-2.5 py-2 text-slate-300\" data-kid=\"1-1-4-2-4-2-2\" data-name=\"token note item 2\">\n                            44px minimum target\n                        </span>\n                        <span class=\"rounded-lg bg-slate-800/60 px-2.5 py-2 text-slate-300\" data-kid=\"1-1-4-2-4-2-3\" data-name=\"token note item 3\">\n                            Solid primary only\n                        </span>\n                        <span class=\"rounded-lg bg-slate-800/60 px-2.5 py-2 text-slate-300\" data-kid=\"1-1-4-2-4-2-4\" data-name=\"token note item 4\">\n                            Visible focus ring\n                        </span>\n                    </div>\n                </div>\n            </section>\n        </div>\n        <section class=\"rounded-[26px] border border-slate-800/90 bg-[#0b1729] p-6 shadow-[0_20px_70px_rgba(0,0,0,0.20)]\" data-kid=\"1-1-5\" data-name=\"history section\">\n            <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-5-1\" data-name=\"history header row\">\n                <div data-kid=\"1-1-5-1-1\" data-name=\"history title group\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-cyan-300\" data-kid=\"1-1-5-1-1-1\" data-name=\"history label\">\n                        Journal history\n                    </p>\n                    <h2 class=\"mt-1 text-xl font-semibold tracking-[-0.02em] text-white\" data-kid=\"1-1-5-1-1-2\" data-name=\"history heading\">\n                        Trade History\n                    </h2>\n                </div>\n                <button class=\"rounded-xl px-3 py-2 text-sm font-medium text-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300/70\" data-kid=\"1-1-5-1-2\" data-name=\"clear filters button\" type=\"button\">\n                    Clear filters\n                </button>\n            </div>\n            <div class=\"mt-5 flex items-center justify-between gap-3\" data-kid=\"1-1-5-2\" data-name=\"filter controls bar\">\n                <div class=\"flex flex-1 items-center gap-3\" data-kid=\"1-1-5-2-1\" data-name=\"filter inputs group\">\n                    <div class=\"min-w-[220px] rounded-xl border border-slate-700 bg-[#091526] px-3.5 py-2.5 text-sm text-slate-500\" data-kid=\"1-1-5-2-1-1\" data-name=\"filter by ticker input\">\n                        Filter by ticker\n                    </div>\n                    <div class=\"min-w-[170px] rounded-xl border border-slate-700 bg-[#091526] px-3.5 py-2.5 text-sm text-slate-500\" data-kid=\"1-1-5-2-1-2\" data-name=\"filter by date input\">\n                        dd/mm/yyyy\n                    </div>\n                    <div class=\"min-w-[170px] rounded-xl border border-slate-700 bg-[#091526] px-3.5 py-2.5 text-sm text-slate-500\" data-kid=\"1-1-5-2-1-3\" data-name=\"filter by strategy input\">\n                        Strategy tag\n                    </div>\n                </div>\n                <button aria-pressed=\"true\" class=\"rounded-xl border border-slate-700 bg-slate-800/80 px-3.5 py-2.5 text-sm font-medium text-slate-200 hover:border-slate-500 hover:bg-slate-700/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300/70\" data-dynamic=\"true\" data-kid=\"1-1-5-2-2\" data-name=\"sort order toggle button\" data-reason=\"state toggled by script\" type=\"button\">\n                    Descending\n                </button>\n            </div>\n            <div class=\"mt-5 overflow-hidden rounded-2xl border border-slate-800\" data-kid=\"1-1-5-3\" data-name=\"history table container\">\n                <table class=\"w-full text-left text-xs\" data-kid=\"1-1-5-3-1\" data-name=\"history table\">\n                    <thead class=\"bg-[#071322] text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-5-3-1-1\" data-name=\"table header group\">\n                        <tr data-kid=\"1-1-5-3-1-1-1\" data-name=\"table header row\">\n                            <th class=\"px-4 py-3\" data-kid=\"1-1-5-3-1-1-1-1\" data-name=\"table header date\">\n                                Date\n                            </th>\n                            <th class=\"px-4 py-3\" data-kid=\"1-1-5-3-1-1-1-2\" data-name=\"table header ticker\">\n                                Ticker\n                            </th>\n                            <th class=\"px-4 py-3\" data-kid=\"1-1-5-3-1-1-1-3\" data-name=\"table header direction\">\n                                Direction\n                            </th>\n                            <th class=\"px-4 py-3\" data-kid=\"1-1-5-3-1-1-1-4\" data-name=\"table header entry\">\n                                Entry\n                            </th>\n                            <th class=\"px-4 py-3\" data-kid=\"1-1-5-3-1-1-1-5\" data-name=\"table header exit\">\n                                Exit\n                            </th>\n                            <th class=\"px-4 py-3\" data-kid=\"1-1-5-3-1-1-1-6\" data-name=\"table header p&l\">\n                                P&L\n                            </th>\n                            <th class=\"px-4 py-3\" data-kid=\"1-1-5-3-1-1-1-7\" data-name=\"table header tags\">\n                                Tags\n                            </th>\n                            <th class=\"px-4 py-3 text-right\" data-kid=\"1-1-5-3-1-1-1-8\" data-name=\"table header action\">\n                                Action\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"divide-y divide-slate-800/80\" data-dynamic=\"true\" data-kid=\"1-1-5-3-1-2\" data-name=\"table body\" data-reason=\"rows populated by script\">\n                        <tr class=\"bg-[#0b1729] text-slate-300\" data-kid=\"1-1-5-3-1-2-1\" data-name=\"table data row 1\">\n                            <td class=\"px-4 py-3.5\" data-kid=\"1-1-5-3-1-2-1-1\" data-name=\"date cell\">\n                                Sep 5, 2026, 10:05 AM\n                            </td>\n                            <td class=\"px-4 py-3.5 font-semibold text-white\" data-kid=\"1-1-5-3-1-2-1-2\" data-name=\"ticker cell\">\n                                NVDA\n                            </td>\n                            <td class=\"px-4 py-3.5\" data-kid=\"1-1-5-3-1-2-1-3\" data-name=\"direction cell\">\n                                <span class=\"rounded-full bg-emerald-400/10 px-2.5 py-1 text-[10px] font-semibold text-emerald-300\" data-kid=\"1-1-5-3-1-2-1-3-1\" data-name=\"direction tag\">\n                                    Long\n                                </span>\n                            </td>\n                            <td class=\"px-4 py-3.5\" data-kid=\"1-1-5-3-1-2-1-4\" data-name=\"entry cell\">\n                                $129.20\n                            </td>\n                            <td class=\"px-4 py-3.5\" data-kid=\"1-1-5-3-1-2-1-5\" data-name=\"exit cell\">\n                                $126.40\n                            </td>\n                            <td class=\"px-4 py-3.5 font-semibold text-rose-300\" data-kid=\"1-1-5-3-1-2-1-6\" data-name=\"p&l cell\">\n                                -$168.00\n                            </td>\n                            <td class=\"px-4 py-3.5 text-slate-400\" data-kid=\"1-1-5-3-1-2-1-7\" data-name=\"tags cell\">\n                                Momentum, AI\n                            </td>\n                            <td class=\"px-4 py-3.5 text-right\" data-kid=\"1-1-5-3-1-2-1-8\" data-name=\"action cell\">\n                                <button class=\"min-h-10 rounded-xl px-3 py-2 text-xs font-semibold text-rose-300 hover:bg-rose-400/10 hover:text-rose-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-300/70\" data-kid=\"1-1-5-3-1-2-1-8-1\" data-name=\"delete button\" type=\"button\">\n                                    Delete\n                                </button>\n                            </td>\n                        </tr>\n                        <tr class=\"bg-[#0b1729] text-slate-300\" data-kid=\"1-1-5-3-1-2-2\" data-name=\"table data row 2\">\n                            <td class=\"px-4 py-3.5\" data-kid=\"1-1-5-3-1-2-2-1\" data-name=\"date cell\">\n                                Sep 3, 2026, 2:42 PM\n                            </td>\n                            <td class=\"px-4 py-3.5 font-semibold text-white\" data-kid=\"1-1-5-3-1-2-2-2\" data-name=\"ticker cell\">\n                                TSLA\n                            </td>\n                            <td class=\"px-4 py-3.5\" data-kid=\"1-1-5-3-1-2-2-3\" data-name=\"direction cell\">\n                                <span class=\"rounded-full bg-amber-400/10 px-2.5 py-1 text-[10px] font-semibold text-amber-300\" data-kid=\"1-1-5-3-1-2-2-3-1\" data-name=\"direction tag\">\n                                    Short\n                                </span>\n                            </td>\n                            <td class=\"px-4 py-3.5\" data-kid=\"1-1-5-3-1-2-2-4\" data-name=\"entry cell\">\n                                $261.80\n                            </td>\n                            <td class=\"px-4 py-3.5\" data-kid=\"1-1-5-3-1-2-2-5\" data-name=\"exit cell\">\n                                $249.40\n                            </td>\n                            <td class=\"px-4 py-3.5 font-semibold text-emerald-300\" data-kid=\"1-1-5-3-1-2-2-6\" data-name=\"p&l cell\">\n                                $620.00\n                            </td>\n                            <td class=\"px-4 py-3.5 text-slate-400\" data-kid=\"1-1-5-3-1-2-2-7\" data-name=\"tags cell\">\n                                Reversal, News risk\n                            </td>\n                            <td class=\"px-4 py-3.5 text-right\" data-kid=\"1-1-5-3-1-2-2-8\" data-name=\"action cell\">\n                                <button class=\"min-h-10 rounded-xl px-3 py-2 text-xs font-semibold text-rose-300 hover:bg-rose-400/10 hover:text-rose-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-300/70\" data-kid=\"1-1-5-3-1-2-2-8-1\" data-name=\"delete button\" type=\"button\">\n                                    Delete\n                                </button>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </section>\n        <section class=\"rounded-[26px] border border-slate-800/90 bg-[#0b1729] p-6 shadow-[0_20px_70px_rgba(0,0,0,0.20)]\" data-kid=\"1-1-6\" data-name=\"execution sandbox section\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-6-1\" data-name=\"sandbox header\">\n                <div data-kid=\"1-1-6-1-1\" data-name=\"sandbox title group\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-violet-300\" data-kid=\"1-1-6-1-1-1\" data-name=\"sandbox label\">\n                        Execution sandbox\n                    </p>\n                    <h2 class=\"mt-1 text-xl font-semibold text-white\" data-kid=\"1-1-6-1-1-2\" data-name=\"sandbox heading\">\n                        Tradovate controls\n                    </h2>\n                </div>\n                <span class=\"rounded-full border border-emerald-300/20 bg-emerald-300/[0.06] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-emerald-300\" data-dynamic=\"true\" data-kid=\"1-1-6-1-2\" data-name=\"sandbox status badge\" data-reason=\"updated by connection script\">\n                    Paper session\n                </span>\n            </div>\n            <div class=\"mt-5 grid grid-cols-[1.1fr_0.9fr] gap-4\" data-kid=\"1-1-6-2\" data-name=\"sandbox controls grid\">\n                <div class=\"rounded-2xl border border-slate-800 bg-[#071322] p-4\" data-kid=\"1-1-6-2-1\" data-name=\"environment control panel\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-6-2-1-1\" data-name=\"environment header group\">\n                        <div data-kid=\"1-1-6-2-1-1-1\" data-name=\"environment identity group\">\n                            <p class=\"text-sm font-semibold text-white\" data-kid=\"1-1-6-2-1-1-1-1\" data-name=\"environment title\">\n                                Sandbox Environment\n                            </p>\n                            <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-6-2-1-1-1-2\" data-name=\"environment detail\">\n                                SIM-TRA-1001 · demo-user\n                            </p>\n                        </div>\n                        <button class=\"rounded-xl border border-slate-700 px-3.5 py-2 text-xs font-semibold text-slate-200 hover:border-emerald-300/60 hover:bg-emerald-300/10 hover:text-emerald-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300/70\" data-kid=\"1-1-6-2-1-1-2\" data-name=\"connect button\" type=\"button\">\n                            Connect\n                        </button>\n                    </div>\n                    <p class=\"mt-4 text-xs leading-5 text-slate-400\" data-kid=\"1-1-6-2-1-2\" data-name=\"sandbox description text\">\n                        Connect to enable the simulated order ticket. The connection state stays neutral until it is active.\n                    </p>\n                </div>\n                <div class=\"rounded-2xl border border-slate-800 bg-[#071322] p-4\" data-kid=\"1-1-6-2-2\" data-name=\"order control panel\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-6-2-2-1\" data-name=\"order ticket header group\">\n                        <div data-kid=\"1-1-6-2-2-1-1\" data-name=\"order info group\">\n                            <p class=\"text-sm font-semibold text-white\" data-kid=\"1-1-6-2-2-1-1-1\" data-name=\"order title\">\n                                Order ticket\n                            </p>\n                            <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-6-2-2-1-1-2\" data-name=\"order detail\">\n                                AAPL · Buy · 1 share\n                            </p>\n                        </div>\n                        <button class=\"rounded-xl bg-violet-400 px-3.5 py-2 text-xs font-semibold text-[#120c24] shadow-[0_8px_20px_rgba(167,139,250,0.12)] hover:bg-violet-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-200 focus-visible:ring-offset-2 focus-visible:ring-offset-[#071322]\" data-kid=\"1-1-6-2-2-1-2\" data-name=\"send simulated order button\" type=\"button\">\n                            Send Simulated Order\n                        </button>\n                    </div>\n                    <div class=\"mt-4 flex items-center justify-between gap-2\" data-kid=\"1-1-6-2-2-2\" data-name=\"order action button group\">\n                        <button class=\"rounded-xl border border-slate-700 px-3 py-2 text-[11px] font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white\" data-kid=\"1-1-6-2-2-2-1\" data-name=\"advance status button\" type=\"button\">\n                            Advance Status\n                        </button>\n                        <button class=\"rounded-xl px-3 py-2 text-[11px] font-semibold text-rose-300 hover:bg-rose-400/10 hover:text-rose-200\" data-kid=\"1-1-6-2-2-2-2\" data-name=\"remove order button\" type=\"button\">\n                            Remove\n                        </button>\n                        <button class=\"rounded-xl border border-slate-700 px-3 py-2 text-[11px] font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white\" data-kid=\"1-1-6-2-2-2-3\" data-name=\"cycle status button\" type=\"button\">\n                            Cycle Status\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <footer class=\"flex items-center justify-between border-t border-slate-800/80 px-1 pt-4 text-[11px] text-slate-600\" data-kid=\"1-1-7\" data-name=\"footer bar\">\n            <span data-kid=\"1-1-7-1\" data-name=\"footer copy text\">\n                Trading journal · calm controls for high-attention work\n            </span>\n            <span data-kid=\"1-1-7-2\" data-name=\"footer version info text\">\n                Button system option 01 / 03\n            </span>\n        </footer>\n    </div>\n</div>\n",
