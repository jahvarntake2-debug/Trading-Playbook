lass=\"mt-2 text-2xl font-semibold tracking-[-0.03em] text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-4-2\" data-name=\"average win/loss value\" data-reason=\"value updated based on trade data\">\n                    $566 / $168\n                </p>\n            </div>\n        </section>\n        <section class=\"grid grid-cols-3 gap-3\" data-kid=\"1-1-3\" data-name=\"trade stats grid\">\n            <div class=\"rounded-2xl border border-slate-800 bg-[#0b1729] px-4 py-3\" data-kid=\"1-1-3-1\" data-name=\"average trade card\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-500\" data-kid=\"1-1-3-1-1\" data-name=\"average trade label\">\n                    Average trade\n                </p>\n                <p class=\"mt-2 text-lg font-semibold text-white\" data-dynamic=\"true\" data-kid=\"1-1-3-1-2\" data-name=\"average trade value\" data-reason=\"value updated based on trade data\">\n                    $321.33\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-3-1-3\" data-name=\"average trade description\">\n                    Mean performance across all logged trades\n                </p>\n            </div>\n            <div class=\"rounded-2xl border border-slate-800 bg-[#0b1729] px-4 py-3\" data-kid=\"1-1-3-2\" data-name=\"best trade card\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-500\" data-kid=\"1-1-3-2-1\" data-name=\"best trade label\">\n                    Best trade\n                </p>\n                <p class=\"mt-2 text-lg font-semibold text-white\" data-dynamic=\"true\" data-kid=\"1-1-3-2-2\" data-name=\"best trade value\" data-reason=\"value updated based on trade data\">\n                    TSLA · $620.00\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3\" data-name=\"best trade timestamp\" data-reason=\"value updated based