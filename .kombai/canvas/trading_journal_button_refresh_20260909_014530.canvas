      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#06111f] px-6 py-8 font-sans text-slate-100\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, ui-sans-serif, system-ui, sans-serif;\">\n    <div class=\"mx-auto max-w-[1180px]\" data-kid=\"1-1\" data-name=\"dashboard main container\">\n        <header class=\"rounded-[16px] border border-[#26354a] bg-[#0b1728] px-7 py-6 shadow-[0_18px_50px_rgba(2,6,23,0.24)]\" data-kid=\"1-1-1\" data-name=\"page header section\">\n            <div class=\"flex flex-col gap-6 xl:flex-row xl:items-center xl:justify-between\" data-kid=\"1-1-1-1\" data-name=\"header content wrapper\">\n                <div class=\"min-w-[240px]\" data-kid=\"1-1-1-1-1\" data-name=\"header branding and title\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.28em] text-cyan-300\" data-kid=\"1-1-1-1-1-1\" data-name=\"page section label\">\n                        Trading journal\n                    </p>\n                    <h1 class=\"mt-2 text-[29px] font-semibold leading-tight tracking-[-0.03em] text-white\" data-kid=\"1-1-1-1-1-2\" data-name=\"page main headline\">\n                        Stock Performance Dashboard\n                    </h1>\n                    <p class=\"mt-2 text-sm text-slate-400\" data-kid=\"1-1-1-1-1-3\" data-name=\"page description text\">\n                        A calm workspace for reviewing risk, recording intent, and learning from every trade.\n                    </p>\n                </div>\n                <div class=\"flex flex-col gap-4 xl:items-end\" data-kid=\"1-1-1-1-2\" data-name=\"header action buttons wrapper\">\n                    <nav aria-label=\"Primary navigation\" class=\"flex flex-wrap items-center gap-1 rounded-[16px] border border-[#26354a] bg-[#071120] p-1.5\" data-kid=\"1-1-1-1-2-1\" data-name=\"primary navigation menu\">\n                        <button class=\"min-h-11 rounded-[12px] bg-[#7265d8] px-4 text-sm font-semibold text-white shadow-[0_8px_20px_rgba(114,101,216,0.18)]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"active dashboard navigation button\">\n                            Dashboard\n                        </button>\n                        <button class=\"min-h-11 rounded-[12px] px-4 text-sm font-medium text-slate-400 hover:bg-[#122036] hover:text-slate-100\" data-kid=\"1-1-1-1-2-1-2\" data-name=\"analytics navigation button\">\n                            Analytics\n                        </button>\n                        <button class=\"min-h-11 rounded-[12px] px-4 text-sm font-medium text-slate-400 hover:bg-[#122036] hover:text-slate-100\" data-kid=\"1-1-1-1-2-1-3\" data-name=\"position size navigation button\">\n                            Position Size\n                        </button>\n                        <button class=\"min-h-11 rounded-[12px] px-4 text-sm font-medium text-slate-400 hover:bg-[#122036] hover:text-slate-100\" data-kid=\"1-1-1-1-2-1-4\" data-name=\"tradovate navigation button\">\n                            Tradovate\n                        </button>\n                    </nav>\n                    <div class=\"flex flex-wrap items-center justify-end gap-2\" data-kid=\"1-1-1-1-2-2\" data-name=\"utility action buttons wrapper\">\n                        <button class=\"min-h-11 rounded-[16px] border border-[#304158] bg-transparent px-4 text-sm font-medium text-slate-300 hover:border-[#5a6b85] hover:bg-[#101f33]\" data-kid=\"1-1-1-1-2-2-1\" data-name=\"light mode toggle button\">\n                            Light mode\n                        </button>\n                        <button class=\"min-h-11 rounded-[16px] border border-[#304158] bg-transparent px-4 text-sm font-medium text-slate-300 hover:border-[#5a6b85] hover:bg-[#101f33]\" data-kid=\"1-1-1-1-2-2-2\" data-name=\"export csv button\">\n                            Export CSV\n                        </button>\n                        <button class=\"min-h-11 rounded-[16px] border border-[#304158] bg-transparent px-4 text-sm font-medium text-slate-300 hover:border-[#5a6b85] hover:bg-[#101f33]\" data-kid=\"1-1-1-1-2-2-3\" data-name=\"import csv button\">\n                            Import CSV\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <section class=\"mt-6 grid gap-3 md:grid-cols-2 xl:grid-cols-4\" data-kid=\"1-1-2\" data-name=\"statistics metrics grid\">\n            <article class=\"rounded-[16px] border border-[#285a60] bg-[#0a202c] p-5\" data-kid=\"1-1-2-1\" data-name=\"total pnl metric card\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-400\" data-kid=\"1-1-2-1-1\" data-name=\"total pnl label\">\n                    Total P&L\n                </p>\n                <p class=\"mt-3 text-[25px] font-semibold tracking-[-0.02em] text-emerald-300\" data-kid=\"1-1-2-1-2\" data-name=\"total pnl value\">\n                    $964.00\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-2-1-3\" data-name=\"total pnl period change text\">\n                    +12.4% this month\n                </p>\n            </article>\n            <article class=\"rounded-[16px] border border-[#2a5167] bg-[#0b1d2c] p-5\" data-kid=\"1-1-2-2\" data-name=\"win rate metric card\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-400\" data-kid=\"1-1-2-2-1\" data-name=\"win rate label\">\n                    Win rate\n                </p>\n                <p class=\"mt-3 text-[25px] font-semibold tracking-[-0.02em] text-white\" data-kid=\"1-1-2-2-2\" data-name=\"win rate value\">\n                    66.7%\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-2-2-3\" data-name=\"win rate explanation text\">\n                    2 of 3 trades profitable\n                </p>\n            </article>\n            <article class=\"rounded-[16px] border border-[#285a60] bg-[#0a202c] p-5\" data-kid=\"1-1-2-3\" data-name=\"profit factor metric card\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-400\" data-kid=\"1-1-2-3-1\" data-name=\"profit factor label\">\n                    Profit factor\n                </p>\n                <p class=\"mt-3 text-[25px] font-semibold tracking-[-0.02em] text-white\" data-kid=\"1-1-2-3-2\" data-name=\"profit factor value\">\n                    6.74\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-2-3-3\" data-name=\"profit factor definition text\">\n                    Gross wins ÷ gross losses\n                </p>\n            </article>\n            <article class=\"rounded-[16px] border border-[#2a5167] bg-[#0b1d2c] p-5\" data-kid=\"1-1-2-4\" data-name=\"average win loss metric card\">\n                <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-400\" data-kid=\"1-1-2-4-1\" data-name=\"average win loss label\">\n                    Average win / loss\n                </p>\n                <p class=\"mt-3 text-[22px] font-semibold tracking-[-0.02em] text-white\" data-kid=\"1-1-2-4-2\" data-name=\"average win loss value\">\n                    $566.00 / $168.00\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-2-4-3\" data-name=\"average win loss context text\">\n                    Across all logged trades\n                </p>\n            </article>\n        </section>\n        <div class=\"mt-6 grid gap-6 xl:grid-cols-[1.08fr_0.92fr]\" data-kid=\"1-1-3\" data-name=\"interactive tools and history container\">\n            <section class=\"rounded-[16px] border border-[#26354a] bg-[#0b1728] p-6 shadow-[0_18px_50px_rgba(2,6,23,0.16)]\" data-kid=\"1-1-3-1\" data-name=\"record trade section\">\n                <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-3-1-1\" data-name=\"record trade header\">\n                    <div data-kid=\"1-1-3-1-1-1\" data-name=\"record trade header text group\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-500\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"section secondary label\">\n                            Daily review\n                        </p>\n                        <h2 class=\"mt-1 text-xl font-semibold text-white\" data-kid=\"1-1-3-1-1-1-2\" data-name=\"record trade section headline\">\n                            Record Trade\n                        </h2>\n                    </div>\n                    <span class=\"rounded-full border border-[#304158] bg-[#101f33] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400\" data-kid=\"1-1-3-1-1-2\" data-name=\"trade count status badge\">\n                        3 logged\n                    </span>\n                </div>\n                <div class=\"mt-5 rounded-[16px] border border-[#1e6870] bg-[#0b2532] p-4\" data-kid=\"1-1-3-1-2\" data-name=\"ticker data information box\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-3-1-2-1\" data-name=\"ticker status wrapper\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-cyan-300\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"ticker status label\">\n                            Live / delayed ticker data\n                        </p>\n                        <span class=\"text-xs text-slate-500\" data-kid=\"1-1-3-1-2-1-2\" data-name=\"ticker source info\">\n                            Free demo feed\n                        </span>\n                    </div>\n                    <p class=\"mt-2 text-sm leading-6 text-slate-300\" data-kid=\"1-1-3-1-2-2\" data-name=\"ticker input instructions\">\n                        Type a ticker symbol to automatically enrich the trade with current price, company name, and ATR.\n                    </p>\n                </div>\n                <div class=\"mt-5 grid gap-4 sm:grid-cols-2\" data-kid=\"1-1-3-1-3\" data-name=\"trade input fields form grid\">\n                    <label class=\"block\" data-kid=\"1-1-3-1-3-1\" data-name=\"date time field\">\n                        <span class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-3-1-3-1-1\" data-name=\"date time label\">\n                            Date / time\n                        </span>\n                        <input class=\"min-h-11 w-full rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-200 outline-none placeholder:text-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-1-3-1-2\" data-name=\"date time input\" readonly=\"\" value=\"09/09/2026, 01:46 AM\"/>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-3-1-3-2\" data-name=\"ticker symbol field\">\n                        <span class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-3-1-3-2-1\" data-name=\"ticker symbol label\">\n                            Ticker symbol\n                        </span>\n                        <input class=\"min-h-11 w-full rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm font-medium uppercase text-slate-200 outline-none placeholder:text-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-1-3-2-2\" data-name=\"ticker symbol input\" readonly=\"\" value=\"AAPL\"/>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-3-1-3-3\" data-name=\"direction selection field\">\n                        <span class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-3-1-3-3-1\" data-name=\"direction selection label\">\n                            Direction\n                        </span>\n                        <select class=\"min-h-11 w-full rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-200 outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-1-3-3-2\" data-name=\"direction selection dropdown\">\n                            <option data-kid=\"1-1-3-1-3-3-2-1\" data-name=\"long direction option\">\n                                Long\n                            </option>\n                        </select>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-3-1-3-4\" data-name=\"position size field\">\n                        <span class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-3-1-3-4-1\" data-name=\"position size label\">\n                            Position size\n                        </span>\n                        <input class=\"min-h-11 w-full rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-300 outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-1-3-4-2\" data-name=\"position size input\" readonly=\"\" value=\"0\"/>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-3-1-3-5\" data-name=\"entry price field\">\n                        <span class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-3-1-3-5-1\" data-name=\"entry price label\">\n                            Entry price\n                        </span>\n                        <input class=\"min-h-11 w-full rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-300 outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-1-3-5-2\" data-name=\"entry price input\" readonly=\"\" value=\"0.00\"/>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-3-1-3-6\" data-name=\"exit price field\">\n                        <span class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-3-1-3-6-1\" data-name=\"exit price label\">\n                            Exit price\n                        </span>\n                        <input class=\"min-h-11 w-full rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-300 outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-1-3-6-2\" data-name=\"exit price input\" readonly=\"\" value=\"0.00\"/>\n                    </label>\n                </div>\n                <div class=\"mt-5 rounded-[16px] border border-[#1f6874] bg-[#0c2937] px-4 py-3.5\" data-kid=\"1-1-3-1-4\" data-name=\"net pnl display box\">\n                    <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-3-1-4-1\" data-name=\"net pnl details wrapper\">\n                        <div data-kid=\"1-1-3-1-4-1-1\" data-name=\"net pnl value group\">\n                            <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-cyan-300\" data-kid=\"1-1-3-1-4-1-1-1\" data-name=\"net pnl label\">\n                                Net P&L\n                            </p>\n                            <p class=\"mt-1 text-xl font-semibold text-emerald-300\" data-kid=\"1-1-3-1-4-1-1-2\" data-name=\"net pnl value\">\n                                $0.00\n                            </p>\n                        </div>\n                        <div class=\"text-right text-xs text-slate-400\" data-kid=\"1-1-3-1-4-1-2\" data-name=\"net pnl calculation info\">\n                            <p data-kid=\"1-1-3-1-4-1-2-1\" data-name=\"calculation method title\">\n                                Auto-calculated\n                            </p>\n                            <p class=\"mt-1 font-medium text-slate-200\" data-kid=\"1-1-3-1-4-1-2-2\" data-name=\"calculation explanation text\">\n                                Based on direction × position size\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-5 grid gap-4 sm:grid-cols-2\" data-kid=\"1-1-3-1-5\" data-name=\"tag input fields grid\">\n                    <label class=\"block\" data-kid=\"1-1-3-1-5-1\" data-name=\"strategy tags field\">\n                        <span class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-3-1-5-1-1\" data-name=\"strategy tags label\">\n                            Strategy / setup tags\n                        </span>\n                        <input class=\"min-h-11 w-full rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-300 outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-1-5-1-2\" data-name=\"strategy tags input\" readonly=\"\" value=\"Momentum, Breakout, FOMC\"/>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-3-1-5-2\" data-name=\"emotional state field\">\n                        <span class=\"mb-2 block text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-3-1-5-2-1\" data-name=\"emotional state label\">\n                            Emotional state / mindset\n                        </span>\n                        <input class=\"min-h-11 w-full rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-300 outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-1-5-2-2\" data-name=\"emotional state input\" readonly=\"\" value=\"Calm, impulsive, focused\"/>\n                    </label>\n                </div>\n                <div class=\"mt-5 flex flex-col gap-3 border-t border-[#1b2b40] pt-5 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-3-1-6\" data-name=\"trade saving footer\">\n                    <div class=\"flex items-center gap-2 text-xs text-slate-500\" data-kid=\"1-1-3-1-6-1\" data-name=\"save status wrapper\">\n                        <span class=\"h-2 w-2 rounded-full bg-emerald-400\" data-kid=\"1-1-3-1-6-1-1\" data-name=\"save status indicator dot\">\n                        </span>\n                        All required fields are ready\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-1-3-1-6-2\" data-name=\"save action buttons wrapper\">\n                        <span class=\"rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-2 text-xs font-medium text-emerald-300\" data-kid=\"1-1-3-1-6-2-1\" data-name=\"save confirmation badge\">\n                            Saved\n                        </span>\n                        <button class=\"min-h-11 rounded-[16px] bg-cyan-400 px-5 text-sm font-semibold text-[#06202a] shadow-[0_8px_22px_rgba(34,211,238,0.16)] hover:bg-cyan-300 focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2 focus:ring-offset-[#0b1728] active:translate-y-px\" data-kid=\"1-1-3-1-6-2-2\" data-name=\"save trade button\">\n                            Save Trade\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <section class=\"rounded-[16px] border border-[#26354a] bg-[#0b1728] p-6 shadow-[0_18px_50px_rgba(2,6,23,0.16)]\" data-kid=\"1-1-3-2\" data-name=\"trade history section\">\n                <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-3-2-1\" data-name=\"trade history header\">\n                    <div data-kid=\"1-1-3-2-1-1\" data-name=\"trade history header text group\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-500\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"history secondary label\">\n                            Journal archive\n                        </p>\n                        <h2 class=\"mt-1 text-xl font-semibold text-white\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"trade history headline\">\n                            Trade History\n                        </h2>\n                    </div>\n                    <button class=\"min-h-11 rounded-[16px] px-3.5 text-sm font-medium text-cyan-300 hover:bg-[#122036] hover:text-cyan-200 focus:outline-none focus:ring-2 focus:ring-cyan-300/50\" data-kid=\"1-1-3-2-1-2\" data-name=\"clear filters button\">\n                        Clear filters\n                    </button>\n                </div>\n                <div class=\"mt-5 grid gap-3 sm:grid-cols-2\" data-kid=\"1-1-3-2-2\" data-name=\"history filters grid\">\n                    <input class=\"min-h-11 rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-300 outline-none placeholder:text-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-2-2-1\" data-name=\"ticker filter input\" placeholder=\"Filter by ticker\"/>\n                    <input class=\"min-h-11 rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-300 outline-none placeholder:text-slate-600 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-2-2-2\" data-name=\"strategy tag filter input\" placeholder=\"Strategy tag\"/>\n                    <select class=\"min-h-11 rounded-[16px] border border-[#304158] bg-[#081322] px-3.5 text-sm text-slate-300 outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20\" data-kid=\"1-1-3-2-2-3\" data-name=\"date sort dropdown\">\n                        <option data-kid=\"1-1-3-2-2-3-1\" data-name=\"sort date option\">\n                            Sort by date\n                        </option>\n                    </select>\n                    <button class=\"min-h-11 rounded-[16px] border border-[#304158] bg-[#101f33] px-3.5 text-sm font-medium text-slate-300 hover:border-[#5a6b85] hover:bg-[#15273e]\" data-kid=\"1-1-3-2-2-4\" data-name=\"order direction toggle button\">\n                        Descending\n                    </button>\n                </div>\n                <div class=\"mt-5 overflow-hidden rounded-[16px] border border-[#1e2e44]\" data-kid=\"1-1-3-2-3\" data-name=\"history table container\">\n                    <div class=\"grid grid-cols-[1.2fr_0.6fr_0.75fr_0.75fr_auto] gap-3 border-b border-[#1e2e44] bg-[#081322] px-4 py-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-3-2-3-1\" data-name=\"history table header row\">\n                        <span data-kid=\"1-1-3-2-3-1-1\" data-name=\"table header date\">\n                            Date\n                        </span>\n                        <span data-kid=\"1-1-3-2-3-1-2\" data-name=\"table header ticker\">\n                            Ticker\n                        </span>\n                        <span data-kid=\"1-1-3-2-3-1-3\" data-name=\"table header direction\">\n                            Direction\n                        </span>\n                        <span data-kid=\"1-1-3-2-3-1-4\" data-name=\"table header pnl\">\n                            P&L\n                        </span>\n                        <span data-kid=\"1-1-3-2-3-1-5\" data-name=\"table header action\">\n                            Action\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-[1.2fr_0.6fr_0.75fr_0.75fr_auto] items-center gap-3 border-b border-[#1e2e44] px-4 py-4 text-sm\" data-kid=\"1-1-3-2-3-2\" data-name=\"trade log row 1\">\n                        <span class=\"text-slate-400\" data-kid=\"1-1-3-2-3-2-1\" data-name=\"trade log date\">\n                            Sep 5, 2026\n                            <br data-kid=\"1-1-3-2-3-2-1-1\" data-name=\"trade log time\"/>\n                            <span class=\"text-xs text-slate-600\" data-kid=\"1-1-3-2-3-2-1-2\" data-name=\"trade log time text\">\n                                10:05 AM\n                            </span>\n                        </span>\n                        <span class=\"font-semibold text-white\" data-kid=\"1-1-3-2-3-2-2\" data-name=\"trade log ticker\">\n                            NVDA\n                        </span>\n                        <span class=\"rounded-full bg-emerald-400/10 px-2.5 py-1 text-center text-xs font-medium text-emerald-300\" data-kid=\"1-1-3-2-3-2-3\" data-name=\"trade log direction\">\n                            Long\n                        </span>\n                        <span class=\"font-semibold text-rose-300\" data-kid=\"1-1-3-2-3-2-4\" data-name=\"trade log pnl\">\n                            −$168.00\n                        </span>\n                        <button class=\"min-h-11 rounded-[12px] px-3 text-xs font-medium text-rose-300 hover:bg-rose-400/10 hover:text-rose-200 focus:outline-none focus:ring-2 focus:ring-rose-300/50\" data-kid=\"1-1-3-2-3-2-5\" data-name=\"trade log delete button\">\n                            Delete\n                        </button>\n                    </div>\n                    <div class=\"grid grid-cols-[1.2fr_0.6fr_0.75fr_0.75fr_auto] items-center gap-3 bg-[#0d1b2d] px-4 py-4 text-sm\" data-kid=\"1-1-3-2-3-3\" data-name=\"trade log row 2\">\n                        <span class=\"text-slate-400\" data-kid=\"1-1-3-2-3-3-1\" data-name=\"trade log date\">\n                            Sep 3, 2026\n                            <br data-kid=\"1-1-3-2-3-3-1-1\" data-name=\"trade log time\"/>\n                            <span class=\"text-xs text-slate-600\" data-kid=\"1-1-3-2-3-3-1-2\" data-name=\"trade log time text\">\n                                2:42 PM\n                            </span>\n                        </span>\n                        <span class=\"font-semibold text-white\" data-kid=\"1-1-3-2-3-3-2\" data-name=\"trade log ticker\">\n                            TSLA\n                        </span>\n                        <span class=\"rounded-full bg-amber-400/10 px-2.5 py-1 text-center text-xs font-medium text-amber-300\" data-kid=\"1-1-3-2-3-3-3\" data-name=\"trade log direction\">\n                            Short\n                        </span>\n                        <span class=\"font-semibold text-emerald-300\" data-kid=\"1-1-3-2-3-3-4\" data-name=\"trade log pnl\">\n                            $620.00\n                        </span>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-2-3-3-5\" data-name=\"trade log delete confirmation\">\n                            <span class=\"whitespace-nowrap text-xs font-medium text-rose-200\" data-kid=\"1-1-3-2-3-3-5-1\" data-name=\"delete confirm prompt\">\n                                Delete trade?\n                            </span>\n                            <button class=\"min-h-11 rounded-[12px] border border-rose-300/30 bg-rose-400/10 px-3 text-xs font-semibold text-rose-200\" data-kid=\"1-1-3-2-3-3-5-2\" data-name=\"confirm delete button\">\n                                Delete\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-4 text-xs text-slate-500\" data-kid=\"1-1-3-2-4\" data-name=\"history section instructions\">\n                    Destructive actions stay quiet until selected, then name the consequence and offer a clear recovery point.\n                </p>\n            </section>\n        </div>\n        <section class=\"mt-6 rounded-[16px] border border-[#26354a] bg-[#0b1728] p-6\" data-kid=\"1-1-4\" data-name=\"button specimen section\">\n            <div class=\"flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between\" data-kid=\"1-1-4-1\" data-name=\"button specimen header wrapper\">\n                <div data-kid=\"1-1-4-1-1\" data-name=\"button specimen text group\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-500\" data-kid=\"1-1-4-1-1-1\" data-name=\"specimen secondary label\">\n                        Button system specimen\n                    </p>\n                    <h2 class=\"mt-1 text-xl font-semibold text-white\" data-kid=\"1-1-4-1-1-2\" data-name=\"specimen headline\">\n                        Quiet defaults, explicit states\n                    </h2>\n                    <p class=\"mt-2 text-sm text-slate-400\" data-kid=\"1-1-4-1-1-3\" data-name=\"specimen description\">\n                        The same hierarchy carries from the dashboard into the simulated order workflow.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap gap-3\" data-kid=\"1-1-4-1-2\" data-name=\"button variations list\">\n                    <button class=\"min-h-11 rounded-[16px] bg-cyan-400 px-4 text-sm font-semibold text-[#06202a]\" data-kid=\"1-1-4-1-2-1\" data-name=\"primary action button\">\n                        Primary action\n                    </button>\n                    <button class=\"min-h-11 rounded-[16px] border border-[#304158] bg-transparent px-4 text-sm font-medium text-slate-300\" data-kid=\"1-1-4-1-2-2\" data-name=\"ghost utility button\">\n                        Ghost utility\n                    </button>\n                    <button class=\"min-h-11 rounded-[16px] border border-cyan-300/70 bg-[#102b38] px-4 text-sm font-semibold text-cyan-200 ring-2 ring-cyan-300/30 ring-offset-2 ring-offset-[#0b1728]\" data-kid=\"1-1-4-1-2-3\" data-name=\"focused button state\">\n                        Focused\n                    </button>\n                    <button class=\"min-h-11 rounded-[16px] border border-[#304158] bg-[#172940] px-4 text-sm font-medium text-white shadow-inner shadow-cyan-300/10\" data-kid=\"1-1-4-1-2-4\" data-name=\"pressed button state\">\n                        Pressed\n                    </button>\n                    <button class=\"min-h-11 cursor-not-allowed rounded-[16px] border border-[#26354a] bg-[#111c2b] px-4 text-sm font-medium text-slate-600\" data-kid=\"1-1-4-1-2-5\" data-name=\"disabled button state\" disabled=\"\">\n                        Disabled\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-6 rounded-[16px] border border-[#26354a] bg-[#0b1728] p-6\" data-kid=\"1-1-5\" data-name=\"sandbox simulation section\">\n            <div class=\"flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between\" data-kid=\"1-1-5-1\" data-name=\"sandbox header wrapper\">\n                <div data-kid=\"1-1-5-1-1\" data-name=\"sandbox text group\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.24em] text-slate-500\" data-kid=\"1-1-5-1-1-1\" data-name=\"sandbox label\">\n                        Tradovate simulation\n                    </p>\n                    <h2 class=\"mt-1 text-xl font-semibold text-white\" data-kid=\"1-1-5-1-1-2\" data-name=\"sandbox headline\">\n                        Sandbox controls\n                    </h2>\n                    <p class=\"mt-2 text-sm text-slate-400\" data-kid=\"1-1-5-1-1-3\" data-name=\"sandbox description\">\n                        Connection and order actions use the same calm geometry without competing with the journal CTA.\n                    </p>\n                </div>\n                <button class=\"min-h-11 rounded-[16px] border border-[#304158] bg-transparent px-4 text-sm font-semibold text-slate-200 hover:border-cyan-300/60 hover:text-cyan-200\" data-kid=\"1-1-5-1-2\" data-name=\"connect simulation button\">\n                    Connect\n                </button>\n            </div>\n            <div class=\"mt-5 grid gap-4 md:grid-cols-3\" data-kid=\"1-1-5-2\" data-name=\"sandbox controls grid\">\n                <div class=\"rounded-[16px] border border-[#1e2e44] bg-[#081322] p-4\" data-kid=\"1-1-5-2-1\" data-name=\"account info card\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-5-2-1-1\" data-name=\"account label\">\n                        Account\n                    </p>\n                    <p class=\"mt-2 text-lg font-semibold text-white\" data-kid=\"1-1-5-2-1-2\" data-name=\"account id value\">\n                        SIM-TRA-1001\n                    </p>\n                    <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-5-2-1-3\" data-name=\"account type text\">\n                        Paper environment\n                    </p>\n                </div>\n                <div class=\"rounded-[16px] border border-[#1e2e44] bg-[#081322] p-4\" data-kid=\"1-1-5-2-2\" data-name=\"order ticket card\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-5-2-2-1\" data-name=\"order ticket label\">\n                        Order ticket\n                    </p>\n                    <p class=\"mt-2 text-lg font-semibold text-white\" data-kid=\"1-1-5-2-2-2\" data-name=\"order details value\">\n                        AAPL · 1 share\n                    </p>\n                    <button class=\"mt-3 min-h-11 w-full rounded-[16px] bg-cyan-400 px-3 text-xs font-semibold text-[#06202a]\" data-kid=\"1-1-5-2-2-3\" data-name=\"send order button\">\n                        Send Simulated Order\n                    </button>\n                </div>\n                <div class=\"rounded-[16px] border border-[#1e2e44] bg-[#081322] p-4\" data-kid=\"1-1-5-2-3\" data-name=\"position control card\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-5-2-3-1\" data-name=\"position label\">\n                        Open position\n                    </p>\n                    <div class=\"mt-2 flex items-center justify-between gap-3\" data-kid=\"1-1-5-2-3-2\" data-name=\"position details wrapper\">\n                        <span class=\"font-semibold text-white\" data-kid=\"1-1-5-2-3-2-1\" data-name=\"position symbol and direction\">\n                            AAPL · Long\n                        </span>\n                        <span class=\"text-xs font-semibold text-emerald-300\" data-kid=\"1-1-5-2-3-2-2\" data-name=\"position pnl value\">\n                            +$1.50\n                        </span>\n                    </div>\n                    <div class=\"mt-3 flex flex-wrap gap-2\" data-kid=\"1-1-5-2-3-3\" data-name=\"position action buttons\">\n                        <button class=\"min-h-11 rounded-[12px] border border-[#304158] bg-transparent px-3 text-xs font-medium text-slate-300\" data-kid=\"1-1-5-2-3-3-1\" data-name=\"advance status button\">\n                            Advance Status\n                        </button>\n                        <button class=\"min-h-11 rounded-[12px] px-3 text-xs font-medium text-rose-300 hover:bg-rose-400/10\" data-kid=\"1-1-5-2-3-3-2\" data-name=\"remove position button\">\n                            Remove\n                        </button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-4 flex flex-wrap items-center justify-between gap-3 rounded-[16px] border border-[#1e2e44] bg-[#081322] px-4 py-3\" data-kid=\"1-1-5-3\" data-name=\"recent order log row\">\n                <div data-kid=\"1-1-5-3-1\" data-name=\"recent order info\">\n                    <p class=\"text-sm font-medium text-white\" data-kid=\"1-1-5-3-1-1\" data-name=\"recent order title\">\n                        Recent order · TSLA\n                    </p>\n                    <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-1-5-3-1-2\" data-name=\"recent order status\">\n                        Queued (demo) · Limit\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap gap-2\" data-kid=\"1-1-5-3-2\" data-name=\"order action buttons\">\n                    <button class=\"min-h-11 rounded-[12px] border border-[#304158] bg-transparent px-3 text-xs font-medium text-slate-300\" data-kid=\"1-1-5-3-2-1\" data-name=\"cycle order status button\">\n                        Cycle Status\n                    </button>\n                    <button class=\"min-h-11 rounded-[12px] px-3 text-xs font-medium text-rose-300 hover:bg-rose-400/10\" data-kid=\"1-1-5-3-2-2\" data-name=\"delete order button\">\n                        Delete\n                    </button>\n                </div>\n            </div>\n        </section>\n    </div>\n</div>\n",
