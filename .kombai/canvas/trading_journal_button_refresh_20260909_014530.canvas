      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#07111f] font-['Inter'] text-slate-100\" data-kid=\"1\">\n    <div class=\"mx-auto max-w-[1240px] px-7 py-7\" data-kid=\"1-1\">\n        <header class=\"border border-slate-800 bg-[#0a1628] shadow-[0_18px_55px_rgba(2,6,23,0.28)]\" data-kid=\"1-1-1\">\n            <div class=\"flex items-start justify-between gap-8 px-7 py-6\" data-kid=\"1-1-1-1\">\n                <div class=\"min-w-[255px]\" data-kid=\"1-1-1-1-1\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.28em] text-cyan-400\" data-kid=\"1-1-1-1-1-1\">\n                        Trading journal\n                    </p>\n                    <h1 class=\"mt-2 text-[29px] font-semibold tracking-[-0.03em] text-white\" data-kid=\"1-1-1-1-1-2\" data-name=\"dashboard title\">\n                        Stock Performance Dashboard\n                    </h1>\n                    <p class=\"mt-2 text-xs text-slate-500\" data-kid=\"1-1-1-1-1-3\">\n                        A focused record of decisions, risk, and outcomes.\n                    </p>\n                </div>\n                <div class=\"flex flex-1 items-start justify-end gap-5\" data-kid=\"1-1-1-1-2\">\n                    <nav aria-label=\"Primary navigation\" class=\"flex h-10 items-stretch border border-slate-700 bg-[#08111f]\" data-kid=\"1-1-1-1-2-1\">\n                        <button aria-current=\"page\" class=\"border-l-2 border-cyan-400 bg-slate-800/80 px-4 text-sm font-semibold text-white\" data-kid=\"1-1-1-1-2-1-1\">\n                            Dashboard\n                        </button>\n                        <button class=\"border-l border-slate-800 px-4 text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-200\" data-kid=\"1-1-1-1-2-1-2\">\n                            Analytics\n                        </button>\n                        <button class=\"border-l border-slate-800 px-4 text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-200\" data-kid=\"1-1-1-1-2-1-3\">\n                            Position Size\n                        </button>\n                        <button class=\"border-l border-slate-800 px-4 text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-slate-200\" data-kid=\"1-1-1-1-2-1-4\">\n                            Tradovate\n                        </button>\n                    </nav>\n                    <div class=\"flex gap-2\" data-kid=\"1-1-1-1-2-2\">\n                        <button class=\"h-10 border border-slate-600 px-3 text-xs font-semibold text-slate-300 hover:border-slate-400 hover:text-white\" data-kid=\"1-1-1-1-2-2-1\">\n                            Light mode\n                        </button>\n                        <button class=\"h-10 border border-slate-600 px-3 text-xs font-semibold text-slate-300 hover:border-slate-400 hover:bg-slate-800\" data-kid=\"1-1-1-1-2-2-2\">\n                            Export CSV\n                        </button>\n                        <button class=\"h-10 border border-slate-600 px-3 text-xs font-semibold text-slate-300 hover:border-slate-400 hover:bg-slate-800\" data-kid=\"1-1-1-1-2-2-3\">\n                            Import CSV\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <main class=\"mt-6 space-y-6\" data-kid=\"1-1-2\">\n            <section aria-label=\"Performance summary\" class=\"grid grid-cols-4 gap-3\" data-kid=\"1-1-2-1\">\n                <div class=\"border border-slate-800 bg-[#0a1628] px-5 py-4\" data-kid=\"1-1-2-1-1\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-500\" data-kid=\"1-1-2-1-1-1\">\n                        Total P&L\n                    </p>\n                    <p class=\"mt-2 text-2xl font-semibold tabular-nums text-emerald-300\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2\" data-name=\"total p&l value\" data-reason=\"updated based on trade records\">\n                        $964.00\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-emerald-400/70\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-3\" data-name=\"total p&l percentage change\" data-reason=\"calculated from monthly performance\">\n                        +12.4% this month\n                    </p>\n                </div>\n                <div class=\"border border-slate-800 bg-[#0a1628] px-5 py-4\" data-kid=\"1-1-2-1-2\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-500\" data-kid=\"1-1-2-1-2-1\">\n                        Win rate\n                    </p>\n                    <p class=\"mt-2 text-2xl font-semibold tabular-nums text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2\" data-name=\"win rate percentage value\" data-reason=\"recalculated based on closed trades\">\n                        66.7%\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-slate-500\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-3\" data-name=\"win rate record description\" data-reason=\"updated based on wins/losses count\">\n                        2 wins / 1 loss\n                    </p>\n                </div>\n                <div class=\"border border-slate-800 bg-[#0a1628] px-5 py-4\" data-kid=\"1-1-2-1-3\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-500\" data-kid=\"1-1-2-1-3-1\">\n                        Profit factor\n                    </p>\n                    <p class=\"mt-2 text-2xl font-semibold tabular-nums text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-1-3-2\" data-name=\"profit factor value\" data-reason=\"calculated from trade history\">\n                        6.74\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-slate-500\" data-kid=\"1-1-2-1-3-3\">\n                        Strong expectancy\n                    </p>\n                </div>\n                <div class=\"border border-slate-800 bg-[#0a1628] px-5 py-4\" data-kid=\"1-1-2-1-4\">\n                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-500\" data-kid=\"1-1-2-1-4-1\">\n                        Average win / loss\n                    </p>\n                    <p class=\"mt-2 text-2xl font-semibold tabular-nums text-white\" data-dynamic=\"true\" data-kid=\"1-1-2-1-4-2\" data-name=\"average win and loss values\" data-reason=\"calculated from average trade data\">\n                        $566 / $168\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-slate-500\" data-kid=\"1-1-2-1-4-3\">\n                        Per closed trade\n                    </p>\n                </div>\n            </section>\n            <div class=\"grid grid-cols-[1.25fr_0.75fr] gap-6\" data-kid=\"1-1-2-2\">\n                <section aria-labelledby=\"record-trade-heading\" class=\"border border-slate-800 bg-[#0a1628]\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"flex items-center justify-between border-b border-slate-800 px-6 py-5\" data-kid=\"1-1-2-2-1-1\">\n                        <div data-kid=\"1-1-2-2-1-1-1\">\n                            <p class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-cyan-400\" data-kid=\"1-1-2-2-1-1-1-1\">\n                                Primary workflow\n                            </p>\n                            <h2 class=\"mt-1 text-lg font-semibold text-white\" data-kid=\"1-1-2-2-1-1-1-2\" id=\"record-trade-heading\">\n                                Record Trade\n                            </h2>\n                        </div>\n                        <span class=\"border border-slate-700 bg-[#08111f] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"record trade section heading\">\n                            3 logged\n                        </span>\n                    </div>\n                    <div class=\"px-6 py-5\" data-kid=\"1-1-2-2-1-2\">\n                        <div class=\"mb-5 border-l-2 border-cyan-500 bg-cyan-500/[0.05] px-4 py-3\" data-kid=\"1-1-2-2-1-2-1\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-2-1-2-1-1\">\n                                <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-cyan-300\" data-kid=\"1-1-2-2-1-2-1-1-1\">\n                                    Live / delayed ticker data\n                                </p>\n                                <span class=\"text-[11px] text-slate-500\" data-kid=\"1-1-2-2-1-2-1-1-2\">\n                                    Free demo feed\n                                </span>\n                            </div>\n                            <p class=\"mt-2 text-xs text-slate-400\" data-kid=\"1-1-2-2-1-2-1-2\">\n                                Type a ticker symbol to enrich the trade with current price, company name, and ATR.\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-x-4 gap-y-4\" data-kid=\"1-1-2-2-1-2-2\">\n                            <label class=\"block\" data-kid=\"1-1-2-2-1-2-2-1\">\n                                <span class=\"mb-1.5 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-2-1-2-2-1-1\">\n                                    Date / time\n                                </span>\n                                <input class=\"h-10 w-full border border-slate-700 bg-[#08111f] px-3 text-sm text-slate-200 outline-none placeholder:text-slate-600 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-2-1-2\" data-name=\"date time input field\" data-reason=\"auto-populated with current timestamp\" readonly=\"\" value=\"09/09/2026, 01:46 AM\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"1-1-2-2-1-2-2-2\">\n                                <span class=\"mb-1.5 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-2-1-2-2-2-1\">\n                                    Ticker symbol\n                                </span>\n                                <input class=\"h-10 w-full border border-slate-700 bg-[#08111f] px-3 text-sm uppercase text-slate-200 outline-none placeholder:text-slate-600 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-2-2-2\" data-name=\"ticker symbol input\" data-reason=\"populated via ticker data feed\" readonly=\"\" value=\"AAPL\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"1-1-2-2-1-2-2-3\">\n                                <span class=\"mb-1.5 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-2-1-2-2-3-1\">\n                                    Direction\n                                </span>\n                                <select class=\"h-10 w-full border border-slate-700 bg-[#08111f] px-3 text-sm text-slate-200 outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50\" data-kid=\"1-1-2-2-1-2-2-3-2\">\n                                    <option data-kid=\"1-1-2-2-1-2-2-3-2-1\">\n                                        Long\n                                    </option>\n                                </select>\n                            </label>\n                            <label class=\"block\" data-kid=\"1-1-2-2-1-2-2-4\">\n                                <span class=\"mb-1.5 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-2-1-2-2-4-1\">\n                                    Position size\n                                </span>\n                                <input class=\"h-10 w-full border border-slate-700 bg-[#08111f] px-3 text-sm text-slate-200 outline-none placeholder:text-slate-600 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-2-4-2\" data-name=\"position size input field\" data-reason=\"dynamically calculated or user-entered\" readonly=\"\" value=\"0\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"1-1-2-2-1-2-2-5\">\n                                <span class=\"mb-1.5 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-2-1-2-2-5-1\">\n                                    Entry price\n                                </span>\n                                <input class=\"h-10 w-full border border-slate-700 bg-[#08111f] px-3 text-sm text-slate-200 outline-none placeholder:text-slate-600 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-2-5-2\" data-name=\"entry price input field\" data-reason=\"populated via data feed\" readonly=\"\" value=\"0.00\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"1-1-2-2-1-2-2-6\">\n                                <span class=\"mb-1.5 block text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-2-1-2-2-6-1\">\n                                    Exit price\n                                </span>\n                                <input class=\"h-10 w-full border border-slate-700 bg-[#08111f] px-3 text-sm text-slate-200 outline-none placeholder:text-slate-600 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/50\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-2-6-2\" data-name=\"exit price input field\" data-reason=\"populated via data feed\" readonly=\"\" value=\"0.00\"/>\n                            </label>\n                        </div>\n                        <div class=\"mt-5 flex items-center justify-between border border-slate-700 bg-[#08111f] px-4 py-3\" data-kid=\"1-1-2-2-1-2-3\">\n                            <div data-kid=\"1-1-2-2-1-2-3-1\">\n                                <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-cyan-400\" data-kid=\"1-1-2-2-1-2-3-1-1\">\n                                    Net P&L\n                                </p>\n                                <p class=\"mt-1 text-xl font-semibold tabular-nums text-emerald-300\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-3-1-2\" data-name=\"net p&l calculation display\" data-reason=\"auto-calculated based on input fields\">\n                                    $0.00\n                                </p>\n                            </div>\n                            <p class=\"text-right text-[11px] text-slate-500\" data-kid=\"1-1-2-2-1-2-3-2\">\n                                Auto-calculated\n                                <br data-kid=\"1-1-2-2-1-2-3-2-1\"/>\n                                <span class=\"text-slate-300\" data-kid=\"1-1-2-2-1-2-3-2-2\">\n                                    Direction × position size\n                                </span>\n                            </p>\n                        </div>\n                        <div class=\"mt-5 grid grid-cols-2 gap-4\" data-kid=\"1-1-2-2-1-2-4\">\n                            <div data-kid=\"1-1-2-2-1-2-4-1\">\n                                <p class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-2-1-2-4-1-1\">\n                                    Strategy / setup tags\n                                </p>\n                                <div class=\"mt-2 h-9 border border-slate-700 bg-[#08111f] px-3 py-2 text-xs text-slate-500\" data-kid=\"1-1-2-2-1-2-4-1-2\">\n                                    Momentum, Breakout, FOMC\n                                </div>\n                            </div>\n                            <div data-kid=\"1-1-2-2-1-2-4-2\">\n                                <p class=\"text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-2-1-2-4-2-1\">\n                                    Emotional state / mindset\n                                </p>\n                                <div class=\"mt-2 h-9 border border-slate-700 bg-[#08111f] px-3 py-2 text-xs text-slate-500\" data-kid=\"1-1-2-2-1-2-4-2-2\">\n                                    Calm, impulsive, focused\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-5 flex items-center justify-between border-t border-slate-800 pt-5\" data-kid=\"1-1-2-2-1-2-5\">\n                            <p class=\"max-w-[430px] text-xs leading-5 text-slate-500\" data-kid=\"1-1-2-2-1-2-5-1\">\n                                Review the setup, risk, and reflection fields before committing this record to your journal.\n                            </p>\n                            <button class=\"h-11 border border-cyan-400 bg-cyan-400 px-5 text-sm font-semibold text-[#04111f] shadow-[0_8px_24px_rgba(34,211,238,0.14)] hover:bg-cyan-300 active:translate-y-px focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2 focus:ring-offset-[#0a1628]\" data-kid=\"1-1-2-2-1-2-5-2\">\n                                Save Trade\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <aside class=\"space-y-6\" data-kid=\"1-1-2-2-2\">\n                    <section aria-labelledby=\"button-states-heading\" class=\"border border-slate-800 bg-[#0a1628]\" data-kid=\"1-1-2-2-2-1\">\n                        <div class=\"border-b border-slate-800 px-5 py-4\" data-kid=\"1-1-2-2-2-1-1\">\n                            <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500\" data-kid=\"1-1-2-2-2-1-1-1\">\n                                System reference\n                            </p>\n                            <h2 class=\"mt-1 text-base font-semibold text-white\" data-kid=\"1-1-2-2-2-1-1-2\" id=\"button-states-heading\">\n                                Button states\n                            </h2>\n                        </div>\n                        <div class=\"space-y-3 px-5 py-4\" data-kid=\"1-1-2-2-2-1-2\">\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-2-1-2-1\">\n                                <span class=\"text-xs text-slate-400\" data-kid=\"1-1-2-2-2-1-2-1-1\">\n                                    Primary / ready\n                                </span>\n                                <button class=\"h-9 border border-cyan-400 bg-cyan-400 px-3 text-xs font-semibold text-[#04111f]\" data-kid=\"1-1-2-2-2-1-2-1-2\">\n                                    Save Trade\n                                </button>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-2-1-2-2\">\n                                <span class=\"text-xs text-slate-400\" data-kid=\"1-1-2-2-2-1-2-2-1\">\n                                    Secondary / quiet\n                                </span>\n                                <button class=\"h-9 border border-slate-600 px-3 text-xs font-semibold text-slate-300 hover:border-slate-400\" data-kid=\"1-1-2-2-2-1-2-2-2\">\n                                    Export CSV\n                                </button>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-2-1-2-3\">\n                                <span class=\"text-xs text-slate-400\" data-kid=\"1-1-2-2-2-1-2-3-1\">\n                                    Focus-visible\n                                </span>\n                                <button class=\"h-9 border border-slate-500 bg-slate-800 px-3 text-xs font-semibold text-white outline-none ring-2 ring-cyan-400 ring-offset-2 ring-offset-[#0a1628]\" data-kid=\"1-1-2-2-2-1-2-3-2\">\n                                    Light mode\n                                </button>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-2-1-2-4\">\n                                <span class=\"text-xs text-slate-400\" data-kid=\"1-1-2-2-2-1-2-4-1\">\n                                    Pressed / selected\n                                </span>\n                                <button class=\"h-9 border-l-2 border-cyan-400 bg-slate-800 px-3 text-xs font-semibold text-white\" data-kid=\"1-1-2-2-2-1-2-4-2\">\n                                    Dashboard\n                                </button>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-2-1-2-5\">\n                                <span class=\"text-xs text-slate-400\" data-kid=\"1-1-2-2-2-1-2-5-1\">\n                                    Disabled\n                                </span>\n                                <button class=\"h-9 border border-slate-800 bg-slate-900 px-3 text-xs font-semibold text-slate-600\" data-kid=\"1-1-2-2-2-1-2-5-2\" disabled=\"\">\n                                    Send Simulated Order\n                                </button>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-2-2-1-2-6\">\n                                <span class=\"text-xs text-slate-400\" data-kid=\"1-1-2-2-2-1-2-6-1\">\n                                    Destructive\n                                </span>\n                                <button class=\"h-9 border border-rose-500/60 px-3 text-xs font-semibold text-rose-300 hover:bg-rose-500/10\" data-kid=\"1-1-2-2-2-1-2-6-2\">\n                                    Delete\n                                </button>\n                            </div>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"tradovate-heading\" class=\"border border-slate-800 bg-[#0a1628]\" data-kid=\"1-1-2-2-2-2\">\n                        <div class=\"flex items-center justify-between border-b border-slate-800 px-5 py-4\" data-kid=\"1-1-2-2-2-2-1\">\n                            <div data-kid=\"1-1-2-2-2-2-1-1\">\n                                <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-300\" data-kid=\"1-1-2-2-2-2-1-1-1\">\n                                    Tradovate simulation\n                                </p>\n                                <h2 class=\"mt-1 text-base font-semibold text-white\" data-kid=\"1-1-2-2-2-2-1-1-2\" id=\"tradovate-heading\">\n                                    Sandbox controls\n                                </h2>\n                            </div>\n                            <button class=\"h-8 border border-slate-600 px-3 text-xs font-semibold text-slate-300 hover:border-slate-400\" data-kid=\"1-1-2-2-2-2-1-2\">\n                                Connect\n                            </button>\n                        </div>\n                        <div class=\"px-5 py-4\" data-kid=\"1-1-2-2-2-2-2\">\n                            <div class=\"flex items-center justify-between border border-slate-800 bg-[#08111f] px-3 py-3\" data-kid=\"1-1-2-2-2-2-2-1\" data-name=\"tradovate simulation status card\">\n                                <div data-kid=\"1-1-2-2-2-2-2-1-1\">\n                                    <p class=\"text-sm font-semibold text-white\" data-kid=\"1-1-2-2-2-2-2-1-1-1\">\n                                        AAPL\n                                    </p>\n                                    <p class=\"mt-1 text-[10px] uppercase tracking-[0.16em] text-slate-500\" data-kid=\"1-1-2-2-2-2-2-1-1-2\">\n                                        Buy · 1 share · Limit\n                                    </p>\n                                </div>\n                                <span class=\"text-[11px] text-emerald-300\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-2-2-1-2\" data-name=\"simulated order status text\" data-reason=\"updated via sandbox state\">\n                                    Queued (demo)\n                                </span>\n                            </div>\n                            <div class=\"mt-3 flex flex-wrap gap-2\" data-kid=\"1-1-2-2-2-2-2-2\">\n                                <button class=\"h-8 border border-slate-600 px-3 text-xs font-semibold text-slate-300 hover:border-cyan-500 hover:text-cyan-300\" data-kid=\"1-1-2-2-2-2-2-2-1\">\n                                    Send Simulated Order\n                                </button>\n                                <button class=\"h-8 border border-slate-700 px-3 text-xs font-semibold text-slate-400 hover:border-slate-500\" data-kid=\"1-1-2-2-2-2-2-2-2\">\n                                    Advance Status\n                                </button>\n                                <button class=\"h-8 border border-rose-500/60 px-3 text-xs font-semibold text-rose-300 hover:bg-rose-500/10\" data-kid=\"1-1-2-2-2-2-2-2-3\">\n                                    Remove\n                                </button>\n                            </div>\n                            <div class=\"mt-4 flex items-center justify-between border-t border-slate-800 pt-3\" data-kid=\"1-1-2-2-2-2-2-3\">\n                                <span class=\"text-xs text-slate-500\" data-kid=\"1-1-2-2-2-2-2-3-1\">\n                                    Recent order\n                                </span>\n                                <button class=\"text-xs font-semibold text-slate-400 underline decoration-slate-700 underline-offset-4 hover:text-slate-200\" data-kid=\"1-1-2-2-2-2-2-3-2\">\n                                    Cycle Status\n                                </button>\n                            </div>\n                        </div>\n                    </section>\n                </aside>\n            </div>\n            <section aria-labelledby=\"history-heading\" class=\"border border-slate-800 bg-[#0a1628]\" data-kid=\"1-1-2-3\">\n                <div class=\"flex items-center justify-between border-b border-slate-800 px-6 py-5\" data-kid=\"1-1-2-3-1\">\n                    <div data-kid=\"1-1-2-3-1-1\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-500\" data-kid=\"1-1-2-3-1-1-1\">\n                            Journal records\n                        </p>\n                        <h2 class=\"mt-1 text-lg font-semibold text-white\" data-kid=\"1-1-2-3-1-1-2\" id=\"history-heading\">\n                            Trade History\n                        </h2>\n                    </div>\n                    <button class=\"h-9 border border-slate-700 px-3 text-xs font-semibold text-slate-400 hover:border-slate-400 hover:text-slate-200\" data-kid=\"1-1-2-3-1-2\">\n                        Clear filters\n                    </button>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 px-6 py-4\" data-kid=\"1-1-2-3-2\">\n                    <div class=\"flex flex-1 gap-3\" data-kid=\"1-1-2-3-2-1\">\n                        <div class=\"h-9 min-w-[190px] border border-slate-700 bg-[#08111f] px-3 py-2 text-xs text-slate-500\" data-kid=\"1-1-2-3-2-1-1\">\n                            Filter by ticker\n                        </div>\n                        <div class=\"h-9 min-w-[150px] border border-slate-700 bg-[#08111f] px-3 py-2 text-xs text-slate-500\" data-kid=\"1-1-2-3-2-1-2\">\n                            dd/mm/yyyy\n                        </div>\n                        <div class=\"h-9 min-w-[145px] border border-slate-700 bg-[#08111f] px-3 py-2 text-xs text-slate-500\" data-kid=\"1-1-2-3-2-1-3\">\n                            Strategy tag\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-3-2-2\">\n                        <span class=\"text-[10px] uppercase tracking-[0.18em] text-slate-500\" data-kid=\"1-1-2-3-2-2-1\">\n                            Sort by date\n                        </span>\n                        <button class=\"h-9 border border-slate-700 bg-[#08111f] px-3 text-xs font-semibold text-slate-300 hover:border-slate-500\" data-kid=\"1-1-2-3-2-2-2\">\n                            Descending\n                        </button>\n                    </div>\n                </div>\n                <div class=\"px-6 pb-2\" data-kid=\"1-1-2-3-3\">\n                    <table class=\"w-full border-collapse text-left text-xs\" data-kid=\"1-1-2-3-3-1\">\n                        <thead data-kid=\"1-1-2-3-3-1-1\">\n                            <tr class=\"border-b border-slate-800 text-[10px] uppercase tracking-[0.16em] text-slate-500\" data-kid=\"1-1-2-3-3-1-1-1\">\n                                <th class=\"pb-3 font-semibold\" data-kid=\"1-1-2-3-3-1-1-1-1\">\n                                    Date\n                                </th>\n                                <th class=\"pb-3 font-semibold\" data-kid=\"1-1-2-3-3-1-1-1-2\">\n                                    Ticker\n                                </th>\n                                <th class=\"pb-3 font-semibold\" data-kid=\"1-1-2-3-3-1-1-1-3\">\n                                    Direction\n                                </th>\n                                <th class=\"pb-3 font-semibold\" data-kid=\"1-1-2-3-3-1-1-1-4\">\n                                    Entry\n                                </th>\n                                <th class=\"pb-3 font-semibold\" data-kid=\"1-1-2-3-3-1-1-1-5\">\n                                    Exit\n                                </th>\n                                <th class=\"pb-3 font-semibold\" data-kid=\"1-1-2-3-3-1-1-1-6\">\n                                    P&L\n                                </th>\n                                <th class=\"pb-3 font-semibold\" data-kid=\"1-1-2-3-3-1-1-1-7\">\n                                    Tags\n                                </th>\n                                <th class=\"pb-3 text-right font-semibold\" data-kid=\"1-1-2-3-3-1-1-1-8\">\n                                    Action\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-dynamic=\"true\" data-kid=\"1-1-2-3-3-1-2\" data-name=\"trade history table body\" data-reason=\"populated by injected list of trade records\">\n                            <tr class=\"border-b border-slate-800/80 text-slate-300\" data-kid=\"1-1-2-3-3-1-2-1\">\n                                <td class=\"py-4\" data-kid=\"1-1-2-3-3-1-2-1-1\">\n                                    Sep 5, 2026 · 10:05 AM\n                                </td>\n                                <td class=\"py-4 font-semibold text-white\" data-kid=\"1-1-2-3-3-1-2-1-2\">\n                                    NVDA\n                                </td>\n                                <td class=\"py-4\" data-kid=\"1-1-2-3-3-1-2-1-3\">\n                                    <span class=\"border border-emerald-500/40 px-2 py-1 text-[10px] font-semibold text-emerald-300\" data-kid=\"1-1-2-3-3-1-2-1-3-1\">\n                                        Long\n                                    </span>\n                                </td>\n                                <td class=\"py-4 tabular-nums\" data-kid=\"1-1-2-3-3-1-2-1-4\">\n                                    $129.20\n                                </td>\n                                <td class=\"py-4 tabular-nums\" data-kid=\"1-1-2-3-3-1-2-1-5\">\n                                    $126.40\n                                </td>\n                                <td class=\"py-4 font-semibold tabular-nums text-rose-300\" data-kid=\"1-1-2-3-3-1-2-1-6\">\n                                    -$168.00\n                                </td>\n                                <td class=\"py-4 text-slate-400\" data-kid=\"1-1-2-3-3-1-2-1-7\">\n                                    Momentum, AI\n                                </td>\n                                <td class=\"py-4 text-right\" data-kid=\"1-1-2-3-3-1-2-1-8\">\n                                    <button class=\"min-h-9 px-3 text-xs font-semibold text-rose-300 underline decoration-rose-500/30 underline-offset-4 hover:text-rose-200\" data-kid=\"1-1-2-3-3-1-2-1-8-1\">\n                                        Delete\n                                    </button>\n                                </td>\n                            </tr>\n                            <tr class=\"text-slate-300\" data-kid=\"1-1-2-3-3-1-2-2\">\n                                <td class=\"py-4\" data-kid=\"1-1-2-3-3-1-2-2-1\">\n                                    Sep 3, 2026 · 2:42 PM\n                                </td>\n                                <td class=\"py-4 font-semibold text-white\" data-kid=\"1-1-2-3-3-1-2-2-2\">\n                                    TSLA\n                                </td>\n                                <td class=\"py-4\" data-kid=\"1-1-2-3-3-1-2-2-3\">\n                                    <span class=\"border border-amber-500/40 px-2 py-1 text-[10px] font-semibold text-amber-300\" data-kid=\"1-1-2-3-3-1-2-2-3-1\">\n                                        Short\n                                    </span>\n                                </td>\n                                <td class=\"py-4 tabular-nums\" data-kid=\"1-1-2-3-3-1-2-2-4\">\n                                    $261.80\n                                </td>\n                                <td class=\"py-4 tabular-nums\" data-kid=\"1-1-2-3-3-1-2-2-5\">\n                                    $249.40\n                                </td>\n                                <td class=\"py-4 font-semibold tabular-nums text-emerald-300\" data-kid=\"1-1-2-3-3-1-2-2-6\">\n                                    $620.00\n                                </td>\n                                <td class=\"py-4 text-slate-400\" data-kid=\"1-1-2-3-3-1-2-2-7\">\n                                    Reversal, News risk\n                                </td>\n                                <td class=\"py-4 text-right\" data-kid=\"1-1-2-3-3-1-2-2-8\">\n                                    <button class=\"min-h-9 px-3 text-xs font-semibold text-rose-300 underline decoration-rose-500/30 underline-offset-4 hover:text-rose-200\" data-kid=\"1-1-2-3-3-1-2-2-8-1\">\n                                        Delete\n                                    </button>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"flex items-center justify-between border-t border-slate-800 px-6 py-3\" data-kid=\"1-1-2-3-4\">\n                    <p class=\"text-[11px] text-slate-500\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4-1\" data-name=\"showing trades counter text\" data-reason=\"updated based on total record count\">\n                        Showing 2 of 3 logged trades\n                    </p>\n                    <span class=\"text-[10px] uppercase tracking-[0.18em] text-slate-600\" data-kid=\"1-1-2-3-4-2\">\n                        Terminal precision system\n                    </span>\n                </div>\n            </section>\n        </main>\n    </div>\n</div>\n",
