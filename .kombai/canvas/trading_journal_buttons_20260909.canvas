      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  :root {\n    --canvas: #06111f;\n    --surface: #0b1729;\n    --surface-deep: #071322;\n    --surface-active: #10263a;\n    --field: #091526;\n    --line: rgba(148, 163, 184, .16);\n    --line-strong: rgba(148, 163, 184, .34);\n    --text: #f8fafc;\n    --text-soft: #cbd5e1;\n    --muted: #8da0b5;\n    --muted-dim: #64748b;\n    --cyan: #42d9ee;\n    --cyan-strong: #22d3ee;\n    --cyan-ink: #04212c;\n    --green: #6ee7b7;\n    --rose: #fda4af;\n    --rose-deep: #341827;\n    --amber: #fbbf24;\n    --radius: 10px;\n  }\n  .dashboard {\n    min-height: 100vh;\n    padding: 28px 42px 72px;\n    color: var(--text);\n    background:\n      radial-gradient(circle at 50% -10%, rgba(34,211,238,.08), transparent 30%),\n      linear-gradient(180deg, #06111f 0%, #071322 55%, #0a1527 100%);\n    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  }\n  .shell { max-width: 1180px; margin: 0 auto; }\n  .topbar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    padding: 22px 24px;\n    border: 1px solid var(--line);\n    border-radius: 18px;\n    background: rgba(11, 23, 41, .88);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.025), 0 18px 42px rgba(2,6,23,.22);\n  }\n  .eyebrow { margin: 0 0 8px; color: var(--cyan); font-size: 10px; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; }\n  h1, h2, h3, p { margin: 0; }\n  h1 { font-size: 28px; line-height: 1.05; letter-spacing: -.045em; font-weight: 700; }\n  h2 { font-size: 19px; line-height: 1.2; letter-spacing: -.025em; font-weight: 650; }\n  h3 { font-size: 15px; font-weight: 650; }\n  .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }\n  .workspace-nav {\n    display: flex;\n    align-items: center;\n    gap: 2px;\n    min-height: 52px;\n    padding: 4px;\n    border: 1px solid var(--line);\n    border-radius: 12px;\n    background: rgba(3, 10, 22, .72);\n  }\n  .btn {\n    min-height: 44px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 0 14px;\n    border: 1px solid transparent;\n    border-radius: var(--radius);\n    color: var(--text-soft);\n    background: rgba(11, 23, 41, .92);\n    font: 600 12px/1 Inter, sans-serif;\n    letter-spacing: -.01em;\n    white-space: nowrap;\n    cursor: pointer;\n    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 150ms ease;\n  }\n  .btn:hover { transform: translateY(-1px); border-color: rgba(66,217,238,.46); color: var(--text); background: #12263a; }\n  .btn:active { transform: translateY(1px); }\n  .btn:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(66,217,238,.22); border-color: var(--cyan); }\n  .btn:disabled { cursor: not-allowed; opacity: .42; transform: none; }\n  .btn-nav { min-height: 42px; padding-inline: 15px; border-color: transparent; background: transparent; color: var(--muted); font-weight: 500; }\n  .btn-nav:hover { border-color: transparent; background: rgba(71,85,105,.28); color: var(--text); }\n  .btn-nav.active { position: relative; color: var(--text); background: var(--surface-active); }\n  .btn-nav.active::after { content: ''; position: absolute; left: 13px; right: 13px; bottom: 4px; height: 2px; border-radius: 999px; background: var(--cyan); }\n  .btn-outline { border-color: var(--line-strong); background: rgba(11,23,41,.7); }\n  .btn-quiet { border-color: transparent; background: transparent; color: var(--muted); }\n  .btn-quiet:hover { background: rgba(71,85,105,.24); color: var(--text); }\n  .btn-primary { min-height: 48px; padding-inline: 20px; border-color: var(--cyan-strong); background: var(--cyan-strong); color: var(--cyan-ink); font-size: 13px; box-shadow: none; }\n  .btn-primary:hover { border-color: var(--cyan); background: var(--cyan); color: #031821; }\n  .btn-danger { border-color: rgba(253,164,175,.46); background: rgba(87,30,52,.45); color: var(--rose); }\n  .btn-danger:hover { border-color: var(--rose); background: var(--rose-deep); color: #ffe4e8; }\n  .btn-sm { min-height: 44px; padding-inline: 12px; font-size: 11px; }\n  .utility-cluster { display: flex; align-items: center; gap: 2px; min-height: 52px; padding: 4px; border: 1px solid var(--line); border-radius: 12px; background: rgba(3,10,22,.72); }\n  .utility-cluster .btn { background: transparent; }\n  .utility-cluster .btn:hover { background: rgba(71,85,105,.28); }\n  .section-label { color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }\n  .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 24px; }\n  .metric { min-height: 124px; padding: 20px; border: 1px solid rgba(34,211,238,.22); border-radius: 14px; background: linear-gradient(145deg, rgba(11,40,54,.75), rgba(8,23,39,.9)); }\n  .metric.negative { border-color: rgba(244,114,182,.32); background: linear-gradient(145deg, rgba(63,24,58,.55), rgba(16,20,39,.92)); }\n  .metric-value { margin-top: 16px; color: var(--text); font-size: 26px; line-height: 1; letter-spacing: -.04em; font-weight: 650; }\n  .metric-value.green { color: var(--green); }\n  .insights { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 14px; }\n  .insight { min-height: 112px; padding: 18px 20px; border: 1px solid rgba(34,211,238,.19); border-radius: 14px; background: rgba(8,35,47,.72); }\n  .insight.negative { border-color: rgba(244,114,182,.3); background: rgba(41,24,48,.68); }\n  .insight-value { margin-top: 12px; color: var(--text); font-size: 19px; font-weight: 650; }\n  .insight-copy { margin-top: 6px; color: var(--text-soft); font-size: 11px; line-height: 1.45; }\n  .content-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr); gap: 16px; margin-top: 24px; }\n  .panel { border: 1px solid var(--line); border-radius: 16px; background: rgba(11,23,41,.82); box-shadow: inset 0 1px 0 rgba(255,255,255,.02), 0 20px 50px rgba(2,6,23,.2); }\n  .panel-inner { padding: 22px; }\n  .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 20px; }\n  .count-badge { padding: 7px 10px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--muted); background: rgba(3,10,22,.6); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; white-space: nowrap; }\n  .ticker-callout { margin-bottom: 18px; padding: 15px; border: 1px solid rgba(34,211,238,.34); border-radius: 12px; background: rgba(3,18,32,.74); }\n  .ticker-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n  .ticker-row h3 { color: var(--cyan); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; }\n  .ticker-row span { color: var(--muted); font-size: 10px; }\n  .ticker-copy { margin-top: 8px; color: var(--text-soft); font-size: 12px; line-height: 1.45; }\n  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px; }\n  .field-label { display: block; color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }\n  .field { width: 100%; min-height: 44px; margin-top: 7px; padding: 0 12px; border: 1px solid var(--line-strong); border-radius: 10px; outline: none; color: var(--text); background: rgba(9,21,38,.92); font: 500 12px/1 Inter, sans-serif; }\n  .field::placeholder { color: var(--muted-dim); }\n  .field:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(66,217,238,.18); }\n  .field-wide { grid-column: 1 / -1; min-height: 74px; padding-block: 11px; resize: none; }\n  .pnl-callout { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 16px; padding: 15px; border: 1px solid rgba(34,211,238,.3); border-radius: 12px; background: rgba(12,48,67,.66); }\n  .pnl-value { margin-top: 7px; color: var(--green); font-size: 22px; font-weight: 650; }\n  .pnl-note { color: var(--text-soft); font-size: 11px; line-height: 1.4; text-align: right; }\n  .check-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 8px; }\n  .check { display: flex; align-items: center; gap: 9px; min-height: 40px; padding: 0 10px; border: 1px solid var(--line); border-radius: 10px; color: var(--text-soft); background: rgba(3,10,22,.58); font-size: 11px; }\n  .check-mark { width: 14px; height: 14px; border: 1px solid var(--line-strong); border-radius: 4px; background: transparent; }\n  .form-footer { display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin-top: 18px; }\n  .status { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 11px; }\n  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 0 3px rgba(34,211,238,.12); }\n  .history-panel { min-width: 0; }\n  .history-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 16px; }\n  .filter-row { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 10px; align-items: center; }\n  .sort-group { display: inline-flex; align-items: stretch; min-height: 44px; margin-top: 10px; border: 1px solid var(--line-strong); border-radius: 10px; background: rgba(3,10,22,.58); overflow: hidden; }\n  .sort-group .sort-select { min-width: 154px; margin: 0; border: 0; border-right: 1px solid var(--line); border-radius: 0; background: transparent; }\n  .sort-group .btn { min-height: 42px; border: 0; border-radius: 0; background: transparent; }\n  .sort-group .btn[aria-pressed='true'] { color: var(--cyan); background: rgba(34,211,238,.1); }\n  .table-wrap { margin-top: 18px; overflow-x: auto; }\n  table { width: 100%; min-width: 720px; border-collapse: collapse; text-align: left; }\n  th { padding: 0 12px 11px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }\n  td { padding: 14px 12px 14px 0; border-bottom: 1px solid rgba(148,163,184,.1); color: var(--text-soft); font-size: 11px; vertical-align: top; }\n  td strong { color: var(--text); font-weight: 650; }\n  td.green { color: var(--green); font-weight: 650; }\n  td.rose { color: var(--rose); font-weight: 650; }\n  .side-pill { display: inline-flex; padding: 5px 8px; border-radius: 999px; color: var(--green); background: rgba(52,211,153,.12); font-size: 10px; font-weight: 600; }\n  .side-pill.short { color: var(--amber); background: rgba(251,191,36,.12); }\n  .action-cell { min-width: 148px; text-align: right; }\n  .confirm-row { display: inline-flex; align-items: center; justify-content: flex-end; gap: 6px; }\n  .bottom-note { margin-top: 12px; color: var(--muted-dim); font-size: 10px; }\n  @media (max-width: 1120px) {\n    .dashboard { padding-inline: 24px; }\n    .topbar { align-items: flex-start; flex-direction: column; }\n    .header-actions { width: 100%; justify-content: flex-start; }\n  }\n  @media (max-width: 900px) {\n    .metrics { grid-template-columns: repeat(2, 1fr); }\n    .content-grid { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 640px) {\n    .dashboard { padding: 18px 14px 48px; }\n    .topbar { padding: 18px; }\n    .workspace-nav, .utility-cluster { width: 100%; overflow-x: auto; }\n    .workspace-nav .btn, .utility-cluster .btn { flex: 1 0 auto; }\n    .metrics, .insights, .form-grid, .check-grid { grid-template-columns: 1fr; }\n    .filter-row { grid-template-columns: 1fr 1fr; }\n    .sort-group { width: 100%; }\n    .sort-group .sort-select { flex: 1; min-width: 0; }\n    .form-footer { align-items: stretch; flex-direction: column; }\n    .form-footer .btn-primary { width: 100%; }\n  }\n</style>\n<div class=\"dashboard\" data-kid=\"1\">\n    <div class=\"shell\" data-kid=\"1-1\">\n        <header class=\"topbar\" data-kid=\"1-1-1\">\n            <div data-kid=\"1-1-1-1\">\n                <p class=\"eyebrow\" data-kid=\"1-1-1-1-1\" data-name=\"trading journal eyebrow text\">\n                    Trading journal\n                </p>\n                <h1 data-kid=\"1-1-1-1-2\" data-name=\"dashboard title\">\n                    Stock Performance Dashboard\n                </h1>\n            </div>\n            <div class=\"header-actions\" data-kid=\"1-1-1-2\">\n                <nav aria-label=\"Primary navigation\" class=\"workspace-nav\" data-kid=\"1-1-1-2-1\">\n                    <button aria-current=\"page\" class=\"btn btn-nav active\" data-kid=\"1-1-1-2-1-1\" data-name=\"navigation dashboard button\">\n                        Dashboard\n                    </button>\n                    <button class=\"btn btn-nav\" data-kid=\"1-1-1-2-1-2\" data-name=\"navigation analytics button\">\n                        Analytics\n                    </button>\n                    <button class=\"btn btn-nav\" data-kid=\"1-1-1-2-1-3\" data-name=\"navigation position size button\">\n                        Position Size\n                    </button>\n                    <button class=\"btn btn-nav\" data-kid=\"1-1-1-2-1-4\" data-name=\"navigation tradovate button\">\n                        Tradovate\n                    </button>\n                </nav>\n                <button class=\"btn btn-outline\" data-kid=\"1-1-1-2-2\" data-name=\"light mode toggle button\">\n                    Light mode\n                </button>\n                <div aria-label=\"File actions\" class=\"utility-cluster\" data-kid=\"1-1-1-2-3\">\n                    <button class=\"btn btn-quiet\" data-kid=\"1-1-1-2-3-1\" data-name=\"export csv button\">\n                        Export CSV\n                    </button>\n                    <button class=\"btn btn-quiet\" data-kid=\"1-1-1-2-3-2\" data-name=\"import csv button\">\n                        Import CSV\n                    </button>\n                </div>\n            </div>\n        </header>\n        <section aria-label=\"Performance metrics\" class=\"metrics\" data-kid=\"1-1-2\">\n            <article class=\"metric\" data-kid=\"1-1-2-1\">\n                <p class=\"section-label\" data-kid=\"1-1-2-1-1\">\n                    Total P&L\n                </p>\n                <p class=\"metric-value green\" data-kid=\"1-1-2-1-2\" data-name=\"total pnl metric value\">\n                    $964.00\n                </p>\n            </article>\n            <article class=\"metric\" data-kid=\"1-1-2-2\">\n                <p class=\"section-label\" data-kid=\"1-1-2-2-1\">\n                    Win rate\n                </p>\n                <p class=\"metric-value\" data-kid=\"1-1-2-2-2\" data-name=\"win rate metric value\">\n                    66.7%\n                </p>\n            </article>\n            <article class=\"metric\" data-kid=\"1-1-2-3\">\n                <p class=\"section-label\" data-kid=\"1-1-2-3-1\">\n                    Profit factor\n                </p>\n                <p class=\"metric-value\" data-kid=\"1-1-2-3-2\" data-name=\"profit factor metric value\">\n                    6.74\n                </p>\n            </article>\n            <article class=\"metric\" data-kid=\"1-1-2-4\">\n                <p class=\"section-label\" data-kid=\"1-1-2-4-1\">\n                    Average win / loss\n                </p>\n                <p class=\"metric-value\" data-kid=\"1-1-2-4-2\" data-name=\"average win loss metric value\">\n                    $566 / $168\n                </p>\n            </article>\n        </section>\n        <section aria-label=\"Trade insights\" class=\"insights\" data-kid=\"1-1-3\">\n            <article class=\"insight\" data-kid=\"1-1-3-1\">\n                <p class=\"section-label\" data-kid=\"1-1-3-1-1\">\n                    Average trade\n                </p>\n                <p class=\"insight-value\" data-kid=\"1-1-3-1-2\" data-name=\"average trade value\">\n                    $321.33\n                </p>\n                <p class=\"insight-copy\" data-kid=\"1-1-3-1-3\">\n                    Mean performance across all logged trades\n                </p>\n            </article>\n            <article class=\"insight\" data-kid=\"1-1-3-2\">\n                <p class=\"section-label\" data-kid=\"1-1-3-2-1\">\n                    Best trade\n                </p>\n                <p class=\"insight-value\" data-kid=\"1-1-3-2-2\" data-name=\"best trade value\">\n                    TSLA · $620.00\n                </p>\n                <p class=\"insight-copy\" data-kid=\"1-1-3-2-3\">\n                    Sep 3, 2026, 2:42 PM\n                </p>\n            </article>\n            <article class=\"insight negative\" data-kid=\"1-1-3-3\">\n                <p class=\"section-label\" data-kid=\"1-1-3-3-1\">\n                    Worst trade\n                </p>\n                <p class=\"insight-value\" data-kid=\"1-1-3-3-2\" data-name=\"worst trade value\">\n                    NVDA · -$168.00\n                </p>\n                <p class=\"insight-copy\" data-kid=\"1-1-3-3-3\">\n                    Sep 5, 2026, 10:05 AM\n                </p>\n            </article>\n        </section>\n        <div class=\"content-grid\" data-kid=\"1-1-4\">\n            <section class=\"panel\" data-kid=\"1-1-4-1\">\n                <div class=\"panel-inner\" data-kid=\"1-1-4-1-1\">\n                    <div class=\"panel-heading\" data-kid=\"1-1-4-1-1-1\">\n                        <h2 data-kid=\"1-1-4-1-1-1-1\">\n                            Record Trade\n                        </h2>\n                        <span class=\"count-badge\" data-kid=\"1-1-4-1-1-1-2\" data-name=\"logged trade count badge\">\n                            3 logged\n                        </span>\n                    </div>\n                    <div class=\"ticker-callout\" data-kid=\"1-1-4-1-1-2\">\n                        <div class=\"ticker-row\" data-kid=\"1-1-4-1-1-2-1\">\n                            <h3 data-kid=\"1-1-4-1-1-2-1-1\">\n                                Live / delayed ticker data\n                            </h3>\n                            <span data-kid=\"1-1-4-1-1-2-1-2\">\n                                Free demo feed\n                            </span>\n                        </div>\n                        <p class=\"ticker-copy\" data-kid=\"1-1-4-1-1-2-2\">\n                            Type a ticker symbol to automatically enrich the trade with current price, company name, and ATR.\n                        </p>\n                    </div>\n                    <form data-kid=\"1-1-4-1-1-3\">\n                        <div class=\"form-grid\" data-kid=\"1-1-4-1-1-3-1\">\n                            <label data-kid=\"1-1-4-1-1-3-1-1\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-1-1-1\">\n                                    Date / time\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-1-1-2\" readonly=\"\" value=\"09/09/2026, 02:18 AM\"/>\n                            </label>\n                            <label data-kid=\"1-1-4-1-1-3-1-2\" data-name=\"trade date input field\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-1-2-1\">\n                                    Ticker symbol\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-1-2-2\" data-name=\"ticker symbol input field\" readonly=\"\" value=\"AAPL\"/>\n                            </label>\n                            <label data-kid=\"1-1-4-1-1-3-1-3\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-1-3-1\">\n                                    Direction\n                                </span>\n                                <select class=\"field\" data-kid=\"1-1-4-1-1-3-1-3-2\" data-name=\"trade direction select\">\n                                    <option data-kid=\"1-1-4-1-1-3-1-3-2-1\">\n                                        Long\n                                    </option>\n                                </select>\n                            </label>\n                            <label data-kid=\"1-1-4-1-1-3-1-4\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-1-4-1\">\n                                    Position size\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-1-4-2\" data-name=\"position size input\" readonly=\"\" value=\"0\"/>\n                            </label>\n                            <label data-kid=\"1-1-4-1-1-3-1-5\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-1-5-1\">\n                                    Entry price\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-1-5-2\" data-name=\"entry price input\" readonly=\"\" value=\"0.00\"/>\n                            </label>\n                            <label data-kid=\"1-1-4-1-1-3-1-6\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-1-6-1\">\n                                    Exit price\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-1-6-2\" data-name=\"exit price input\" readonly=\"\" value=\"0.00\"/>\n                            </label>\n                            <label data-kid=\"1-1-4-1-1-3-1-7\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-1-7-1\">\n                                    Stop-loss\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-1-7-2\" data-name=\"stop loss input\" readonly=\"\" value=\"0.00\"/>\n                            </label>\n                            <label data-kid=\"1-1-4-1-1-3-1-8\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-1-8-1\">\n                                    Take-profit\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-1-8-2\" data-name=\"take profit input\" readonly=\"\" value=\"0.00\"/>\n                            </label>\n                        </div>\n                        <div class=\"pnl-callout\" data-kid=\"1-1-4-1-1-3-2\">\n                            <div data-kid=\"1-1-4-1-1-3-2-1\">\n                                <p class=\"section-label\" data-kid=\"1-1-4-1-1-3-2-1-1\">\n                                    Net P&L\n                                </p>\n                                <p class=\"pnl-value\" data-kid=\"1-1-4-1-1-3-2-1-2\" data-name=\"net pnl value display\">\n                                    $0.00\n                                </p>\n                            </div>\n                            <p class=\"pnl-note\" data-kid=\"1-1-4-1-1-3-2-2\">\n                                Auto-calculated\n                                <br data-kid=\"1-1-4-1-1-3-2-2-1\"/>\n                                <strong data-kid=\"1-1-4-1-1-3-2-2-2\">\n                                    Based on direction × position size\n                                </strong>\n                            </p>\n                        </div>\n                        <div class=\"form-grid\" data-kid=\"1-1-4-1-1-3-3\" style=\"margin-top:16px\">\n                            <label data-kid=\"1-1-4-1-1-3-3-1\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-3-1-1\">\n                                    Strategy / setup tags\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-3-1-2\" data-name=\"strategy tags input\" readonly=\"\" value=\"Momentum, Breakout, FOMC\"/>\n                            </label>\n                            <label data-kid=\"1-1-4-1-1-3-3-2\">\n                                <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-3-2-1\">\n                                    Emotional state / mindset\n                                </span>\n                                <input class=\"field\" data-kid=\"1-1-4-1-1-3-3-2-2\" data-name=\"emotional state input\" readonly=\"\" value=\"Calm, impulsive, focused\"/>\n                            </label>\n                        </div>\n                        <div data-kid=\"1-1-4-1-1-3-4\" style=\"margin-top:16px\">\n                            <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-4-1\">\n                                Mistake tracking matrix\n                            </span>\n                            <div class=\"check-grid\" data-kid=\"1-1-4-1-1-3-4-2\">\n                                <div class=\"check\" data-kid=\"1-1-4-1-1-3-4-2-1\">\n                                    <span class=\"check-mark\" data-kid=\"1-1-4-1-1-3-4-2-1-1\">\n                                    </span>\n                                    FOMO\n                                </div>\n                                <div class=\"check\" data-kid=\"1-1-4-1-1-3-4-2-2\">\n                                    <span class=\"check-mark\" data-kid=\"1-1-4-1-1-3-4-2-2-1\">\n                                    </span>\n                                    Revenge Trading\n                                </div>\n                                <div class=\"check\" data-kid=\"1-1-4-1-1-3-4-2-3\">\n                                    <span class=\"check-mark\" data-kid=\"1-1-4-1-1-3-4-2-3-1\">\n                                    </span>\n                                    Moved Stop Loss\n                                </div>\n                                <div class=\"check\" data-kid=\"1-1-4-1-1-3-4-2-4\">\n                                    <span class=\"check-mark\" data-kid=\"1-1-4-1-1-3-4-2-4-1\">\n                                    </span>\n                                    Early Exit\n                                </div>\n                            </div>\n                        </div>\n                        <label data-kid=\"1-1-4-1-1-3-5\" style=\"display:block;margin-top:16px\">\n                            <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-5-1\">\n                                News / fundamental notes\n                            </span>\n                            <textarea class=\"field field-wide\" data-kid=\"1-1-4-1-1-3-5-2\" data-name=\"news notes textarea\" placeholder=\"Add catalysts, macro context, earnings updates, or key notes...\"></textarea>\n                        </label>\n                        <label data-kid=\"1-1-4-1-1-3-6\" style=\"display:block;margin-top:16px\">\n                            <span class=\"field-label\" data-kid=\"1-1-4-1-1-3-6-1\">\n                                Analytical reflections\n                            </span>\n                            <textarea class=\"field field-wide\" data-kid=\"1-1-4-1-1-3-6-2\" data-name=\"analytical reflections textarea\" placeholder=\"Summarize what worked, what didn’t, and what to improve...\"></textarea>\n                        </label>\n                        <div class=\"form-footer\" data-kid=\"1-1-4-1-1-3-7\">\n                            <span class=\"status\" data-kid=\"1-1-4-1-1-3-7-1\">\n                                <span class=\"status-dot\" data-kid=\"1-1-4-1-1-3-7-1-1\">\n                                </span>\n                                Ready to save\n                            </span>\n                            <button class=\"btn btn-primary\" data-kid=\"1-1-4-1-1-3-7-2\" data-name=\"save trade button\" type=\"button\">\n                                Save Trade\n                            </button>\n                        </div>\n                    </form>\n                </div>\n            </section>\n            <section class=\"panel history-panel\" data-kid=\"1-1-4-2\">\n                <div class=\"panel-inner\" data-kid=\"1-1-4-2-1\">\n                    <div class=\"history-heading\" data-kid=\"1-1-4-2-1-1\">\n                        <div data-kid=\"1-1-4-2-1-1-1\">\n                            <h2 data-kid=\"1-1-4-2-1-1-1-1\">\n                                Trade History\n                            </h2>\n                            <p class=\"bottom-note\" data-kid=\"1-1-4-2-1-1-1-2\">\n                                Review, filter, and protect your journal records.\n                            </p>\n                        </div>\n                        <button class=\"btn btn-quiet btn-sm\" data-kid=\"1-1-4-2-1-1-2\" data-name=\"clear filters button\" disabled=\"\">\n                            Clear filters\n                        </button>\n                    </div>\n                    <div class=\"filter-row\" data-kid=\"1-1-4-2-1-2\">\n                        <input class=\"field\" data-kid=\"1-1-4-2-1-2-1\" data-name=\"filter by ticker input\" placeholder=\"Filter by ticker\"/>\n                        <input class=\"field\" data-kid=\"1-1-4-2-1-2-2\" data-name=\"filter start date input\" placeholder=\"dd/mm/yyyy\"/>\n                        <input class=\"field\" data-kid=\"1-1-4-2-1-2-3\" data-name=\"filter end date input\" placeholder=\"dd/mm/yyyy\"/>\n                        <input class=\"field\" data-kid=\"1-1-4-2-1-2-4\" data-name=\"filter strategy tag input\" placeholder=\"Strategy tag\"/>\n                    </div>\n                    <div aria-label=\"Sort controls\" class=\"sort-group\" data-kid=\"1-1-4-2-1-3\">\n                        <select class=\"field sort-select\" data-kid=\"1-1-4-2-1-3-1\" data-name=\"sort by date select\">\n                            <option data-kid=\"1-1-4-2-1-3-1-1\">\n                                Sort by date\n                            </option>\n                        </select>\n                        <button aria-pressed=\"true\" class=\"btn\" data-kid=\"1-1-4-2-1-3-2\" data-name=\"sort direction toggle button\">\n                            Descending ↕\n                        </button>\n                    </div>\n                    <div class=\"table-wrap\" data-kid=\"1-1-4-2-1-4\">\n                        <table data-kid=\"1-1-4-2-1-4-1\">\n                            <thead data-kid=\"1-1-4-2-1-4-1-1\">\n                                <tr data-kid=\"1-1-4-2-1-4-1-1-1\">\n                                    <th data-kid=\"1-1-4-2-1-4-1-1-1-1\">\n                                        Date\n                                    </th>\n                                    <th data-kid=\"1-1-4-2-1-4-1-1-1-2\">\n                                        Ticker\n                                    </th>\n                                    <th data-kid=\"1-1-4-2-1-4-1-1-1-3\">\n                                        Direction\n                                    </th>\n                                    <th data-kid=\"1-1-4-2-1-4-1-1-1-4\">\n                                        Entry\n                                    </th>\n                                    <th data-kid=\"1-1-4-2-1-4-1-1-1-5\">\n                                        Exit\n                                    </th>\n                                    <th data-kid=\"1-1-4-2-1-4-1-1-1-6\">\n                                        P&L\n                                    </th>\n                                    <th data-kid=\"1-1-4-2-1-4-1-1-1-7\">\n                                        Tags\n                                    </th>\n                                    <th class=\"action-cell\" data-kid=\"1-1-4-2-1-4-1-1-1-8\">\n                                        Action\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody data-kid=\"1-1-4-2-1-4-1-2\">\n                                <tr data-kid=\"1-1-4-2-1-4-1-2-1\">\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-1-1\">\n                                        Sep 5, 2026, 10:05 AM\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-1-2\">\n                                        <strong data-kid=\"1-1-4-2-1-4-1-2-1-2-1\">\n                                            NVDA\n                                        </strong>\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-1-3\">\n                                        <span class=\"side-pill\" data-kid=\"1-1-4-2-1-4-1-2-1-3-1\">\n                                            Long\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-1-4\">\n                                        $129.20\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-1-5\">\n                                        $126.40\n                                    </td>\n                                    <td class=\"rose\" data-kid=\"1-1-4-2-1-4-1-2-1-6\">\n                                        -$168.00\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-1-7\">\n                                        Momentum, AI\n                                    </td>\n                                    <td class=\"action-cell\" data-kid=\"1-1-4-2-1-4-1-2-1-8\">\n                                        <button class=\"btn btn-danger btn-sm\" data-kid=\"1-1-4-2-1-4-1-2-1-8-1\" data-name=\"delete trade button\">\n                                            Delete\n                                        </button>\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-1-4-2-1-4-1-2-2\">\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-2-1\">\n                                        Sep 3, 2026, 2:42 PM\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-2-2\">\n                                        <strong data-kid=\"1-1-4-2-1-4-1-2-2-2-1\">\n                                            TSLA\n                                        </strong>\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-2-3\">\n                                        <span class=\"side-pill short\" data-kid=\"1-1-4-2-1-4-1-2-2-3-1\">\n                                            Short\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-2-4\">\n                                        $261.80\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-2-5\">\n                                        $249.40\n                                    </td>\n                                    <td class=\"green\" data-kid=\"1-1-4-2-1-4-1-2-2-6\">\n                                        $620.00\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-2-7\">\n                                        Reversal, News risk\n                                    </td>\n                                    <td class=\"action-cell\" data-kid=\"1-1-4-2-1-4-1-2-2-8\">\n                                        <div class=\"confirm-row\" data-kid=\"1-1-4-2-1-4-1-2-2-8-1\">\n                                            <button class=\"btn btn-danger btn-sm\" data-kid=\"1-1-4-2-1-4-1-2-2-8-1-1\" data-name=\"confirm delete trade button\">\n                                                Confirm delete\n                                            </button>\n                                            <button class=\"btn btn-quiet btn-sm\" data-kid=\"1-1-4-2-1-4-1-2-2-8-1-2\" data-name=\"cancel delete trade button\">\n                                                Cancel\n                                            </button>\n                                        </div>\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-1-4-2-1-4-1-2-3\">\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-3-1\">\n                                        Sep 1, 2026, 9:15 AM\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-3-2\">\n                                        <strong data-kid=\"1-1-4-2-1-4-1-2-3-2-1\">\n                                            AAPL\n                                        </strong>\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-3-3\">\n                                        <span class=\"side-pill\" data-kid=\"1-1-4-2-1-4-1-2-3-3-1\">\n                                            Long\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-3-4\">\n                                        $212.50\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-3-5\">\n                                        $218.90\n                                    </td>\n                                    <td class=\"green\" data-kid=\"1-1-4-2-1-4-1-2-3-6\">\n                                        $512.00\n                                    </td>\n                                    <td data-kid=\"1-1-4-2-1-4-1-2-3-7\">\n                                        Breakout, Earnings\n                                    </td>\n                                    <td class=\"action-cell\" data-kid=\"1-1-4-2-1-4-1-2-3-8\">\n                                        <button class=\"btn btn-danger btn-sm\" data-kid=\"1-1-4-2-1-4-1-2-3-8-1\">\n                                            Delete\n                                        </button>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                    <p class=\"bottom-note\" data-kid=\"1-1-4-2-1-5\">\n                        Buttons use a 44px minimum target, quiet neutrals for utilities, cyan for the active signal, and rose only for destructive confirmation.\n                    </p>\n                </div>\n            </section>\n        </div>\n    </div>\n</div>\n",
