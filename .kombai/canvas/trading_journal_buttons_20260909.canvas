    "var_aa2c57af2220": {
      "type": "variant",
      "label": "Dashboard buttons — Ledger utility rail",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen bg-[#07111f] px-8 py-8 text-slate-100\" data-kid=\"1\" data-name=\"trading journal page layout container\" style=\"font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap');\n    .ledger-button {\n      display: inline-flex;\n      min-height: 44px;\n      align-items: center;\n      justify-content: center;\n      gap: 0.5rem;\n      border: 1px solid rgba(148, 163, 184, 0.32);\n      border-radius: 9px;\n      padding: 0.625rem 0.875rem;\n      color: #cbd5e1;\n      background: #0f1d30;\n      font-size: 0.8125rem;\n      font-weight: 600;\n      line-height: 1.25;\n      text-align: center;\n      white-space: nowrap;\n      outline: none;\n      transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 150ms ease, opacity 150ms ease;\n    }\n    .ledger-button:hover:not(:disabled) { border-color: rgba(103, 232, 249, 0.58); background: #14263a; color: #f8fafc; }\n    .ledger-button:active:not(:disabled) { transform: translateY(1px); background: #0b1729; }\n    .ledger-button:focus-visible { outline: 2px solid #67e8f9; outline-offset: 3px; }\n    .ledger-button:disabled { cursor: not-allowed; opacity: 0.46; }\n    .ledger-button--sm { min-height: 40px; padding: 0.5rem 0.75rem; font-size: 0.75rem; }\n    .ledger-button--lg { min-height: 50px; padding-inline: 1.25rem; font-size: 0.9375rem; }\n    .ledger-button--primary { border-color: #67e8f9; background: #43c7c8; color: #06202a; }\n    .ledger-button--primary:hover:not(:disabled) { border-color: #a5f3fc; background: #67e8f9; color: #03151d; }\n    .ledger-button--primary:active:not(:disabled) { background: #22b9bd; }\n    .ledger-button--outline { border-color: rgba(148, 163, 184, 0.42); background: transparent; color: #cbd5e1; }\n    .ledger-button--quiet { border-color: transparent; background: transparent; color: #94a3b8; }\n    .ledger-button--quiet:hover:not(:disabled) { border-color: rgba(148, 163, 184, 0.2); background: #122238; color: #f8fafc; }\n    .ledger-button--destructive { border-color: rgba(253, 164, 175, 0.36); background: rgba(127, 29, 55, 0.1); color: #fda4af; }\n    .ledger-button--destructive:hover:not(:disabled) { border-color: rgba(253, 164, 175, 0.72); background: rgba(159, 18, 57, 0.2); color: #ffe4e6; }\n    .ledger-button--nav { border-color: transparent; background: transparent; color: #94a3b8; font-weight: 500; }\n    .ledger-button--nav:hover:not(:disabled) { background: #102033; color: #f8fafc; }\n    .ledger-button--nav-active { border-color: rgba(103, 232, 249, 0.18); background: #14283a; color: #f8fafc; box-shadow: inset 3px 0 0 #67e8f9; font-weight: 700; }\n    .ledger-field { width: 100%; min-height: 46px; border: 1px solid rgba(148, 163, 184, 0.25); border-radius: 9px; background: #0b1729; padding: 0.75rem 0.875rem; color: #f8fafc; outline: none; }\n    .ledger-field::placeholder { color: #64748b; }\n    .ledger-field:focus { border-color: rgba(103, 232, 249, 0.76); box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.18); }\n    .ledger-label { font-family: 'DM Mono', ui-monospace, monospace; font-size: 0.625rem; letter-spacing: 0.2em; text-transform: uppercase; color: #94a3b8; }\n    .ledger-panel { border: 1px solid rgba(148, 163, 184, 0.15); border-radius: 18px; background: rgba(11, 23, 41, 0.9); box-shadow: 0 14px 32px rgba(0, 0, 0, 0.16); }\n    .ledger-rule { border-color: rgba(148, 163, 184, 0.16); }\n    </style>\n    <div class=\"mx-auto max-w-[1180px]\" data-kid=\"1-1\" data-name=\"dashboard main content wrapper\">\n        <header class=\"ledger-panel mb-8 p-6\" data-kid=\"1-1-1\" data-name=\"header panel\">\n            <div class=\"flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between\" data-kid=\"1-1-1-1\" data-name=\"header layout container\">\n                <div data-kid=\"1-1-1-1-1\" data-name=\"dashboard title section\">\n                    <p class=\"ledger-label text-cyan-300\" data-kid=\"1-1-1-1-1-1\" data-name=\"journal label\">\n                        Trading journal\n                    </p>\n                    <h1 class=\"mt-2 text-3xl font-semibold tracking-tight text-white\" data-kid=\"1-1-1-1-1-2\" data-name=\"dashboard title\">\n                        Stock Performance Dashboard\n                    </h1>\n                </div>\n                <div class=\"flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-end\" data-kid=\"1-1-1-1-2\" data-name=\"header action section\">\n                    <nav aria-label=\"Primary navigation\" class=\"flex flex-wrap gap-1 rounded-[12px] border border-slate-800 bg-[#071322] p-1.5\" data-kid=\"1-1-1-1-2-1\" data-name=\"primary navigation menu\">\n                        <button aria-current=\"page\" class=\"ledger-button ledger-button--sm ledger-button--nav ledger-button--nav-active\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"dashboard navigation button\" type=\"button\">\n                            Dashboard\n                        </button>\n                        <button class=\"ledger-button ledger-button--sm ledger-button--nav\" data-kid=\"1-1-1-1-2-1-2\" data-name=\"analytics navigation button\" type=\"button\">\n                            Analytics\n                        </button>\n                        <button class=\"ledger-button ledger-button--sm ledger-button--nav\" data-kid=\"1-1-1-1-2-1-3\" data-name=\"position size navigation button\" type=\"button\">\n                            Position Size\n                        </button>\n                        <button class=\"ledger-button ledger-button--sm ledger-button--nav\" data-kid=\"1-1-1-1-2-1-4\" data-name=\"tradovate navigation button\" type=\"button\">\n                            Tradovate\n                        </button>\n                    </nav>\n                    <div class=\"flex flex-wrap items-center gap-2\"