dence\n                            </label>\n                            <label class=\"flex min-h-11 items-center gap-2 rounded-[9px] border border-slate-700 bg-[#071322] px-3 py-2 text-sm text-slate-200\" data-kid=\"1-1-4-1-3-4-2-6\" data-name=\"overtrading checkbox option\">\n                                <input class=\"h-4 w-4 accent-cyan-400\" data-kid=\"1-1-4-1-3-4-2-6-1\" data-name=\"overtrading checkbox input\" type=\"checkbox\"/>\n                                Overtrading\n                            </label>\n                            <label class=\"flex min-h-11 items-center gap-2 rounded-[9px] border border-slate-700 bg-[#071322] px-3 py-2 text-sm text-slate-200\" data-kid=\"1-1-4-1-3-4-2-7\" data-name=\"poor risk management checkbox option\">\n                                <input class=\"h-4 w-4 accent-cyan-400\" data-kid=\"1-1-4-1-3-4-2-7-1\" data-name=\"poor risk management checkbox input\" type=\"checkbox\"/>\n                                Poor Risk Management\n                            </label>\n                            <label class=\"flex min-h-11 items-center gap-2 rounded-[9px] border border-slate-700 bg-[#071322] px-3 py-2 text-sm text-slate-200\" data-kid=\"1-1-4-1-3-4-2-8\" data-name=\"chasing earnings checkbox option\">\n                                <input class=\"h-4 w-4 accent-cyan-400\" data-kid=\"1-1-4-1-3-4-2-8-1\" data-name=\"chasing earnings checkbox input\" type=\"checkbox\"/>\n                                Chasing Earnings\n                            </label>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-4-1-3-5\" data-name=\"news notes section\">\n                        <span class=\"ledger-label mb-2 block\" data-kid=\"1-1-4-1-3-5-1\" data-name=\"news notes label\">\n                            News / fundamental notes\n                        </span>\n                        <textarea class=\"ledger-field min-h-24\" data-kid=\"1-1-4-1-