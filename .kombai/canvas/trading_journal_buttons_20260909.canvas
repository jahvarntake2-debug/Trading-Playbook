ition size label\">\n                                Position size\n                            </span>\n                            <input class=\"ledger-field\" data-kid=\"1-1-4-1-3-1-4-2\" data-name=\"position size input\" readonly=\"\" value=\"0\"/>\n                        </label>\n                        <label class=\"block\" data-kid=\"1-1-4-1-3-1-5\" data-name=\"entry price field container\">\n                            <span class=\"ledger-label mb-2 block\" data-kid=\"1-1-4-1-3-1-5-1\" data-name=\"entry price label\">\n                                Entry price\n                            </span>\n                            <input class=\"ledger-field\" data-kid=\"1-1-4-1-3-1-5-2\" data-name=\"entry price input\" readonly=\"\" value=\"0.00\"/>\n                        </label>\n                        <label class=\"block\" data-kid=\"1-1-4-1-3-1-6\" data-name=\"exit price field container\">\n                            <span class=\"ledger-label mb-2 block\" data-kid=\"1-1-4-1-3-1-6-1\" data-name=\"exit price label\">\n                                Exit price\n                            </span>\n                            <input class=\"ledger-field\" data-kid=\"1-1-4-1-3-1-6-2\" data-name=\"exit price input\" readonly=\"\" value=\"0.00\"/>\n                        </label>\n                        <label class=\"block\" data-kid=\"1-1-4-1-3-1-7\" data-name=\"stop loss field container\">\n                            <span class=\"ledger-label mb-2 block\" data-kid=\"1-1-4-1-3-1-7-1\" data-name=\"stop loss label\">\n                                Stop-loss\n                            </span>\n                            <input class=\"ledger-field\" data-kid=\"1-1-4-1-3-1-7-2\" data-name=\"stop loss input\" readonly=\"\" value=\"0.00\"/>\n                        </label>\n                        <label class=\"block\" data-kid=\"1-1-4-1-3-1-8\" data-name=\"take profit field container\">\n                            <span class=\"ledger-label mb