le\">\n                            Trade History\n                        </h2>\n                        <p class=\"mt-1 text-sm text-slate-400\" data-kid=\"1-1-4-2-1-1-2\" data-name=\"trade history description\">\n                            Review your journal with a compact, calm control rail.\n                        </p>\n                    </div>\n                    <button class=\"ledger-button ledger-button--sm ledger-button--quiet\" data-kid=\"1-1-4-2-1-2\" data-name=\"clear filters button\" disabled=\"\" type=\"button\">\n                        Clear filters\n                    </button>\n                </div>\n                <div class=\"mb-6 rounded-[12px] border border-slate-800 bg-[#071322] p-3\" data-kid=\"1-1-4-2-2\" data-name=\"filter controls container\">\n                    <div class=\"grid gap-3 md:grid-cols-2 xl:grid-cols-3\" data-kid=\"1-1-4-2-2-1\" data-name=\"filters grid\">\n                        <input class=\"ledger-field\" data-kid=\"1-1-4-2-2-1-1\" data-name=\"ticker filter input\" placeholder=\"Filter by ticker\"/>\n                        <input class=\"ledger-field\" data-kid=\"1-1-4-2-2-1-2\" data-name=\"start date filter input\" placeholder=\"dd/mm/yyyy\"/>\n                        <input class=\"ledger-field\" data-kid=\"1-1-4-2-2-1-3\" data-name=\"end date filter input\" placeholder=\"dd/mm/yyyy\"/>\n                        <input class=\"ledger-field\" data-kid=\"1-1-4-2-2-1-4\" data-name=\"tag filter input\" placeholder=\"Strategy tag\"/>\n                        <div class=\"flex items-center gap-2 xl:col-span-2\" data-kid=\"1-1-4-2-2-1-5\" data-name=\"sorting controls container\">\n                            <select class=\"ledger-field\" data-kid=\"1-1-4-2-2-1-5-1\" data-name=\"sort select input\">\n                                <option data-kid=\"1-1-4-2-2-1-5-1-1\" data-name=\"sort by date option\">\n                                    Sort by date\n                                </option>\n                   