ield\" data-kid=\"1-1-4-1-3-6-2\" data-name=\"exit price input\" placeholder=\"0.00\" type=\"text\"/>\n                    </label>\n                    <label data-kid=\"1-1-4-1-3-7\" data-name=\"stop loss input container\">\n                        <span class=\"field-label\" data-kid=\"1-1-4-1-3-7-1\" data-name=\"stop loss label\">\n                            Stop-Loss\n                        </span>\n                        <input class=\"field\" data-kid=\"1-1-4-1-3-7-2\" data-name=\"stop loss input\" placeholder=\"0.00\" type=\"text\"/>\n                    </label>\n                    <label data-kid=\"1-1-4-1-3-8\" data-name=\"take profit input container\">\n                        <span class=\"field-label\" data-kid=\"1-1-4-1-3-8-1\" data-name=\"take profit label\">\n                            Take-Profit\n                        </span>\n                        <input class=\"field\" data-kid=\"1-1-4-1-3-8-2\" data-name=\"take profit input\" placeholder=\"0.00\" type=\"text\"/>\n                    </label>\n                </div>\n                <div class=\"pnl-strip\" data-kid=\"1-1-4-1-4\" data-name=\"net pnl summary strip\">\n                    <div data-kid=\"1-1-4-1-4-1\" data-name=\"pnl summary value container\">\n                        <p class=\"pnl-kicker\" data-kid=\"1-1-4-1-4-1-1\" data-name=\"pnl summary label\">\n                            Net P&L\n                        </p>\n                        <p class=\"pnl-value\" data-dynamic=\"true\" data-kid=\"1-1-4-1-4-1-2\" data-name=\"pnl summary value\" data-reason=\"value recalculated by script\">\n                            $0.00\n                        </p>\n                    </div>\n                    <div class=\"pnl-side\" data-kid=\"1-1-4-1-4-2\" data-name=\"pnl auto calculation notice\">\n                        Auto-calculated\n                        <br data-kid=\"1-1-4-1-4-2-1\" data-name=\"line break\"/>\n                        <strong data-kid=\"1-1-4-1-4-2-2\" d