  "nodes": {
    "var_1d6a7b3e68cf": {
      "type": "variant",
      "label": "Dashboard buttons — Calm cyan hierarchy",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  .dashboard-page {\n    --canvas: #06111f;\n    --surface: #0b1729;\n    --surface-deep: #071322;\n    --field: #091526;\n    --border-panel: rgba(148, 163, 184, .14);\n    --border-control: rgba(148, 163, 184, .26);\n    --border-strong: rgba(148, 163, 184, .44);\n    --cyan: #22d3ee;\n    --cyan-bright: #67e8f9;\n    --cyan-dim: rgba(34, 211, 238, .13);\n    --positive: #6ee7b7;\n    --positive-dim: rgba(52, 211, 153, .12);\n    --danger: #fda4af;\n    --danger-dim: rgba(251, 113, 133, .10);\n    --amber: #fbbf24;\n    --text: #f8fafc;\n    --text-soft: #cbd5e1;\n    --muted: #94a3b8;\n    --muted-deep: #64748b;\n    --radius-control: 11px;\n    --radius-panel: 26px;\n    --shadow-panel: 0 22px 60px rgba(1, 8, 20, .28);\n    --shadow-primary: 0 10px 22px rgba(34, 211, 238, .12);\n    box-sizing: border-box;\n    min-height: 100%;\n    padding: 32px 40px 56px;\n    color: var(--text);\n    background:\n      radial-gradient(circle at 50% -12%, rgba(34, 211, 238, .10), transparent 31%),\n      linear-gradient(180deg, #020617 0%, var(--canvas) 52%, #0b1729 100%);\n    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  }\n\n  .dashboard-page *, .dashboard-page *::before, .dashboard-page *::after { box-sizing: border-box; }\n  .dashboard-shell { width: min(1168px, 100%); margin: 0 auto; }\n  .glass-panel { border: 1px solid var(--border-panel); background: rgba(11, 23, 41, .80); box-shadow: var(--shadow-panel), inset 0 1px 0 rgba(255,255,255,.025); backdrop-filter: blur(14px); }\n  .section-panel { border-radius: var(--radius-panel); }\n  .eyebrow { margin: 0; color: var(--cyan); font-size: 11px; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; }\n  .muted { color: var(--muted); }\n\n  .dashboard-header { padding: 22px 24px; border-radius: var(--radius-panel); }\n  .header-layout { display: flex; align-items: center; justify-content: space-between; gap: 24px; }\n  .brand-title { margin: 7px 0 0; color: var(--text); font-size: 30px; line-height: 1.08; font-weight: 700; letter-spacing: -.04em; }\n  .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; }\n  .workspace-nav { display: flex; flex-wrap: wrap; gap: 2px; padding: 5px; border: 1px solid rgba(148,163,184,.22); border-radius: 15px; background: rgba(3, 10, 23, .60); }\n  .utility-rail { display: flex; align-items: center; gap: 2px; padding: 4px; border: 1px solid rgba(148,163,184,.22); border-radius: 14px; background: rgba(3, 10, 23, .46); }\n\n  .button, .file-button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: 8px; border: 1px solid transparent; border-radius: var(--radius-control); padding: 10px 14px; color: var(--text-soft); background: transparent; font: 600 13px/1.2 Inter, ui-sans-serif, system-ui, sans-serif; white-space: nowrap; cursor: pointer; outline: none; transition: background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease, color 150ms ease, transform 150ms ease, opacity 150ms ease; }\n  .button:hover:not(:disabled), .file-button:hover { transform: translateY(-1px); }\n  .button:active:not(:disabled), .file-button:active { transform: translateY(1px); }\n  .button:focus-visible, .file-button:focus-within { box-shadow: 0 0 0 3px rgba(34,211,238,.22); }\n  .button:disabled { cursor: not-allowed; opacity: .45; }\n  .button--sm, .file-button--sm { min-height: 44px; padding: 9px 12px; font-size: 12px; }\n  .button--lg { min-height: 48px; padding: 12px 20px; font-size: 14px; }\n  .button--nav { color: var(--muted); font-weight: 500; border-color: transparent; }\n  .button--nav:hover:not(:disabled) { color: var(--text); background: rgba(51,65,85,.50); }\n  .button--nav-active { color: var(--canvas); background: var(--cyan); box-shadow: var(--shadow-primary); font-weight: 700; }\n  .button--nav-active:hover:not(:disabled) { color: var(--canvas); background: var(--cyan-bright); }\n  .button--outline { border-color: var(--border-strong); color: var(--text-soft); background: rgba(11,23,41,.32); }\n  .button--outline:hover:not(:disabled) { border-color: rgba(203,213,225,.62); color: var(--text); background: rgba(51,65,85,.54); }\n  .button--quiet { color: var(--muted); background: transparent; }\n  .button--quiet:hover:not(:disabled) { color: var(--text); background: rgba(51,65,85,.44); }\n  .button--primary { color: var(--canvas); background: var(--cyan); box-shadow: var(--shadow-primary); }\n  .button--primary:hover:not(:disabled) { background: var(--cyan-bright); }\n  .button--primary:active:not(:disabled) { background: #06b6d4; box-shadow: inset 0 2px 5px rgba(0,0,0,.22); }\n  .button--destructive { color: var(--danger); background: transparent; }\n  .button--destructive:hover:not(:disabled) { color: #fecdd3; background: var(--danger-dim); }\n  .file-button { cursor: pointer; }\n  .file-button input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }\n\n  .metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 22px; }\n  .metric-card { min-height: 128px; padding: 20px; border-radius: 20px; }\n  .metric-label { margin: 0; color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .23em; text-transform: uppercase; }\n  .metric-value { margin: 14px 0 0; color: var(--text); font-size: 27px; line-height: 1; font-weight: 600; letter-spacing: -.04em; }\n  .metric-positive { border-color: rgba(52,211,153,.34); background: linear-gradient(135deg, rgba(16,185,129,.12), rgba(11,23,41,.66)); }\n  .metric-info { border-color: rgba(34,211,238,.30); background: linear-gradient(135deg, rgba(34,211,238,.10), rgba(11,23,41,.66)); }\n  .insight-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }\n  .insight-card { min-height: 122px; padding: 20px; border-radius: 20px; }\n  .insight-value { margin: 13px 0 0; color: var(--text); font-size: 22px; font-weight: 600; letter-spacing: -.035em; }\n  .insight-description { margin: 7px 0 0; color: var(--text-soft); font-size: 12px; line-height: 1.45; }\n  .insight-positive { border-color: rgba(52,211,153,.32); background: rgba(16,185,129,.08); }\n  .insight-negative { border-color: rgba(251,113,133,.34); background: rgba(244,63,94,.08); }\n  .insight-info { border-color: rgba(34,211,238,.30); background: rgba(34,211,238,.07); }\n\n  .dashboard-columns { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 1.92fr); gap: 14px; margin-top: 22px; align-items: start; }\n  .form-panel, .history-panel { padding: 24px; }\n  .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 22px; }\n  .panel-title { margin: 0; color: var(--text); font-size: 20px; line-height: 1.1; font-weight: 600; letter-spacing: -.025em; }\n  .count-pill { display: inline-flex; min-height: 30px; align-items: center; padding: 6px 10px; border: 1px solid rgba(148,163,184,.28); border-radius: 999px; color: var(--muted); background: rgba(30,41,59,.55); font-size: 10px; letter-spacing: .20em; text-transform: uppercase; white-space: nowrap; }\n  .ticker-panel { margin-bottom: 20px; padding: 16px; border: 1px solid rgba(34,211,238,.34); border-radius: 17px; background: rgba(3, 10, 23, .52); }\n  .ticker-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n  .ticker-title { margin: 0; color: var(--cyan); font-size: 11px; font-weight: 600; letter-spacing: .20em; text-transform: uppercase; }\n  .ticker-copy { margin: 9px 0 0; color: var(--text-soft); font-size: 12px; line-height: 1.55; }\n  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; }\n  .field-label { display: block; color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .19em; text-transform: uppercase; }\n  .field { width: 100%; min-height: 44px; margin-top: 8px; border: 1px solid var(--border-control); border-radius: 12px; padding: 10px 12px; color: var(--text); background: rgba(9,21,38,.86); font: 13px/1.2 Inter, ui-sans-serif, system-ui, sans-serif; outline: none; }\n  .field::placeholder { color: var(--muted-deep); }\n  .field:focus { border-color: rgba(34,211,238,.72); box-shadow: 0 0 0 3px rgba(34,211,238,.18); }\n  textarea.field { min-height: 82px; resize: vertical; line-height: 1.45; }\n  .pnl-strip { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 18px; padding: 16px; border: 1px solid rgba(34,211,238,.34); border-radius: 17px; background: rgba(34,211,238,.08); }\n  .pnl-kicker { margin: 0; color: var(--cyan); font-size: 10px; font-weight: 600; letter-spacing: .20em; text-transform: uppercase; }\n  .pnl-value { margin: 6px 0 0; color: var(--positive); font-size: 25px; line-height: 1; font-weight: 600; letter-spacing: -.04em; }\n  .pnl-side { color: var(--muted); font-size: 11px; line-height: 1.45; text-align: right; }\n  .pnl-side strong { color: var(--text-soft); font-weight: 600; }\n  .form-footer { display: flex; align-items: center; justify-content: flex-end; gap: 14px; margin-top: 20px; }\n  .action-status { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 11px; }\n  .status-dot { width: 7px; height: 7px; border-radius: 999px; background: var(--positive); box-shadow: 0 0 0 4px rgba(52,211,153,.10); }\n\n  .history-heading { margin-bottom: 18px; }\n  .history-heading .button { flex-shrink: 0; }\n  .filter-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }\n  .sort-group { display: inline-flex; align-items: stretch; gap: 0; margin-top: 12px; border: 1px solid var(--border-control); border-radius: var(--radius-control); overflow: hidden; background: rgba(3,10,23,.34); }\n  .sort-select { min-height: 44px; border: 0; border-right: 1px solid var(--border-control); border-radius: 0; padding: 0 34px 0 12px; color: var(--text-soft); background: transparent; font: 600 12px/1 Inter, ui-sans-serif, system-ui, sans-serif; outline: none; }\n  .sort-select:focus { box-shadow: inset 0 0 0 2px rgba(34,211,238,.55); }\n  .sort-group .button { min-height: 44px; border: 0; border-radius: 0; }\n  .sort-group .button:hover:not(:disabled) { transform: none; background: rgba(51,65,85,.44); }\n  .table-wrap { margin: 20px -4px 0; overflow-x: auto; }\n  .trade-table { width: 100%; border-collapse: collapse; min-width: 660px; text-align: left; font-size: 11px; }\n  .trade-table th { padding: 0 10px 12px 0; border-bottom: 1px solid rgba(148,163,184,.17); color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; white-space: nowrap; }\n  .trade-table td { padding: 14px 10px 14px 0; border-bottom: 1px solid rgba(148,163,184,.11); color: var(--text-soft); vertical-align: top; white-space: nowrap; }\n  .trade-table td strong { color: var(--text); font-weight: 600; }\n  .direction-pill { display: inline-flex; min-height: 24px; align-items: center; padding: 4px 8px; border-radius: 999px; color: var(--positive); background: var(--positive-dim); font-size: 10px; font-weight: 600; }\n  .direction-pill.short { color: var(--amber); background: rgba(245,158,11,.12); }\n  .profit { color: var(--positive) !important; font-weight: 600; }\n  .loss { color: var(--danger) !important; font-weight: 600; }\n  .delete-cell { text-align: right; }\n  .delete-button { min-height: 40px; padding-inline: 10px; }\n\n  @media (max-width: 1120px) {\n    .dashboard-page { padding-inline: 24px; }\n    .header-layout { align-items: flex-start; flex-direction: column; }\n    .header-actions { width: 100%; justify-content: flex-start; }\n    .filter-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  }\n  @media (max-width: 850px) {\n    .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .dashboard-columns { grid-template-columns: 1fr; }\n    .history-panel { min-width: 0; }\n  }\n  @media (max-width: 620px) {\n    .dashboard-page { padding: 20px 14px 34px; }\n    .dashboard-header, .form-panel, .history-panel { padding: 18px; }\n    .brand-title { font-size: 25px; }\n    .header-actions, .workspace-nav, .utility-rail { width: 100%; }\n    .workspace-nav .button { flex: 1 1 auto; }\n    .utility-rail { justify-content: space-between; }\n    .utility-rail .button, .utility-rail .file-button { flex: 1 1 0; }\n    .metric-grid, .insight-grid, .form-grid { grid-template-columns: 1fr; }\n    .filter-grid { grid-template-columns: 1fr; }\n    .sort-group { width: 100%; }\n    .sort-select, .sort-group .button { flex: 1 1 0; }\n    .form-footer { align-items: stretch; flex-direction: column-reverse; }\n    .form-footer .button--lg { width: 100%; }\n    .action-status { justify-content: center; }\n  }\n</style>\n<main class=\"dashboard-page\" data-kid=\"1\" data-name=\"dashboard page layout\">\n    <div class=\"dashboard-shell\" data-kid=\"1-1\" data-name=\"dashboard main shell\">\n        <header class=\"dashboard-header glass-panel\" data-kid=\"1-1-1\" data-name=\"header panel\">\n            <div class=\"header-layout\" data-kid=\"1-1-1-1\" data-name=\"header layout container\">\n                <div data-kid=\"1-1-1-1-1\" data-name=\"brand identity container\">\n                    <p class=\"eyebrow\" data-kid=\"1-1-1-1-1-1\" data-name=\"page breadcrumb eyebrow\">\n                        Trading journal\n                    </p>\n                    <h1 class=\"brand-title\" data-kid=\"1-1-1-1-1-2\" data-name=\"dashboard headline\">\n                        Stock Performance Dashboard\n                    </h1>\n                </div>\n                <div class=\"header-actions\" data-kid=\"1-1-1-1-2\" data-name=\"header actions container\">\n                    <nav aria-label=\"Primary navigation\" class=\"workspace-nav\" data-kid=\"1-1-1-1-2-1\" data-name=\"workspace navigation\">\n                        <button aria-current=\"page\" class=\"button button--sm button--nav button--nav-active\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"active dashboard navigation button\" type=\"button\">\n                            Dashboard\n                        </button>\n                        <button class=\"button button--sm button--nav\" data-kid=\"1-1-1-1-2-1-2\" data-name=\"analytics navigation button\" type=\"button\">\n                            Analytics\n                        </button>\n                        <button class=\"button button--sm button--nav\" data-kid=\"1-1-1-1-2-1-3\" data-name=\"position size navigation button\" type=\"button\">\n                            Position Size\n                        </button>\n                        <button class=\"button button--sm button--nav\" data-kid=\"1-1-1-1-2-1-4\" data-name=\"tradovate navigation button\" type=\"button\">\n                            Tradovate\n                        </button>\n                    </nav>\n                    <button class=\"button button--sm button--outline\" data-kid=\"1-1-1-1-2-2\" data-name=\"toggle light mode button\" type=\"button\">\n                        Light mode\n                    </button>\n                    <div aria-label=\"File actions\" class=\"utility-rail\" data-kid=\"1-1-1-1-2-3\" data-name=\"file utility actions container\">\n                        <button class=\"button button--sm button--quiet\" data-kid=\"1-1-1-1-2-3-1\" data-name=\"export csv button\" type=\"button\">\n                            Export CSV\n                        </button>\n                        <label class=\"file-button file-button--sm button--quiet\" data-kid=\"1-1-1-1-2-3-2\" data-name=\"import csv file input button\">\n                            Import CSV\n                            <input accept=\".csv\" data-kid=\"1-1-1-1-2-3-2-1\" data-name=\"csv file upload input\" type=\"file\"/>\n                        </label>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <section aria-label=\"Performance summary\" class=\"metric-grid\" data-kid=\"1-1-2\" data-name=\"performance metrics grid\">\n            <article class=\"metric-card glass-panel metric-positive\" data-kid=\"1-1-2-1\" data-name=\"total pnl metric card\">\n                <p class=\"metric-label\" data-kid=\"1-1-2-1-1\" data-name=\"total pnl metric label\">\n                    Total P&L\n                </p>\n                <p class=\"metric-value\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"total pnl metric value\" data-reason=\"text updated by script based on trades\">\n                    $964.00\n                </p>\n            </article>\n            <article class=\"metric-card glass-panel metric-info\" data-kid=\"1-1-2-2\" data-name=\"win rate metric card\">\n                <p class=\"metric-label\" data-kid=\"1-1-2-2-1\" data-name=\"win rate metric label\">\n                    Win Rate\n                </p>\n                <p class=\"metric-value\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2\" data-name=\"win rate metric value\" data-reason=\"text updated by script based on trades\">\n                    66.7%\n                </p>\n            </article>\n            <article class=\"metric-card glass-panel metric-positive\" data-kid=\"1-1-2-3\" data-name=\"profit factor metric card\">\n                <p class=\"metric-label\" data-kid=\"1-1-2-3-1\" data-name=\"profit factor metric label\">\n                    Profit Factor\n                </p>\n                <p class=\"metric-value\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2\" data-name=\"profit factor metric value\" data-reason=\"text updated by script based on trades\">\n                    6.74\n                </p>\n            </article>\n            <article class=\"metric-card glass-panel metric-info\" data-kid=\"1-1-2-4\" data-name=\"average win loss metric card\">\n                <p class=\"metric-label\" data-kid=\"1-1-2-4-1\" data-name=\"average win loss metric label\">\n                    Average Win / Loss\n                </p>\n                <p class=\"metric-value\" data-dynamic=\"true\" data-kid=\"1-1-2-4-2\" data-name=\"average win loss metric value\" data-reason=\"text updated by script based on trades\">\n                    $566.00 / $168.00\n                </p>\n            </article>\n        </section>\n        <section aria-label=\"Trade highlights\" class=\"insight-grid\" data-kid=\"1-1-3\" data-name=\"trade insights grid\">\n            <article class=\"insight-card glass-panel insight-info\" data-kid=\"1-1-3-1\" data-name=\"average trade insight card\">\n                <p class=\"metric-label\" data-kid=\"1-1-3-1-1\" data-name=\"average trade insight label\">\n                    Average Trade\n                </p>\n                <p class=\"insight-value\" data-dynamic=\"true\" data-kid=\"1-1-3-1-2\" data-name=\"average trade insight value\" data-reason=\"text updated by script based on trades\">\n                    $321.33\n                </p>\n                <p class=\"insight-description\" data-kid=\"1-1-3-1-3\" data-name=\"average trade insight description\">\n                    Mean performance across all logged trades\n                </p>\n            </article>\n            <article class=\"insight-card glass-panel insight-positive\" data-kid=\"1-1-3-2\" data-name=\"best trade insight card\">\n                <p class=\"metric-label\" data-kid=\"1-1-3-2-1\" data-name=\"best trade insight label\">\n                    Best Trade\n                </p>\n                <p class=\"insight-value\" data-dynamic=\"true\" data-kid=\"1-1-3-2-2\" data-name=\"best trade insight value\" data-reason=\"text updated by script based on trades\">\n                    TSLA · $620.00\n                </p>\n                <p class=\"insight-description\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3\" data-name=\"best trade insight description\" data-reason=\"text updated by script based on trades\">\n                    Sep 3, 2026, 2:42 PM\n                </p>\n            </article>\n            <article class=\"insight-card glass-panel insight-negative\" data-kid=\"1-1-3-3\" data-name=\"worst trade insight card\">\n                <p class=\"metric-label\" data-kid=\"1-1-3-3-1\" data-name=\"worst trade insight label\">\n                    Worst Trade\n                </p>\n                <p class=\"insight-value\" data-dynamic=\"true\" data-kid=\"1-1-3-3-2\" data-name=\"worst trade insight value\" data-reason=\"text updated by script based on trades\">\n                    NVDA · -$168.00\n                </p>\n                <p class=\"insight-description\" data-dynamic=\"true\" data-kid=\"1-1-3-3-3\" data-name=\"worst trade insight description\" data-reason=\"text updated by script based on trades\">\n                    Sep 5, 2026, 10:05 AM\n                </p>\n            </article>\n        </section>\n        <div class=\"dashboard-columns\" data-kid=\"1-1-4\" data-name=\"dashboard content columns\">\n            <section aria-labelledby=\"record-title\" class=\"form-panel section-panel glass-panel\" data-kid=\"1-1-4-1\" data-name=\"record trade form panel\">\n                <div class=\"panel-heading\" data-kid=\"1-1-4-1-1\" data-name=\"record trade panel header\">\n                    <h2 class=\"panel-title\" data-kid=\"1-1-4-1-1-1\" data-name=\"record trade title\" id=\"record-title\">\n                        Record Trade\n                    </h2>\n                    <span class=\"count-pill\" data-dynamic=\"true\" data-kid=\"1-1-4-1-1-2\" data-name=\"logged trades count indicator\" data-reason=\"text updated by script when trades are added\">\n                        3 logged\n                    </span>\n                </div>\n                <div class=\"ticker-panel\